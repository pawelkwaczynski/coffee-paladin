LOG = os.path.join(BASE, "guard.log")
CFG = os.path.join(BASE, "config.json")


SUPPORTED_LANGS = ("en", "pl", "ru", "zh", "es")


def _lang():
    v = (os.environ.get("TG_LANG") or "").lower()[:2]
    if v in SUPPORTED_LANGS:
        return v
    try:
        with open(CFG) as f:
            v = (json.load(f).get("lang") or "").lower()[:2]
        if v in SUPPORTED_LANGS:
            return v
    except Exception:
        pass
    return "en"


