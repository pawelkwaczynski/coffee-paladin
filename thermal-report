    return DICTS.get(LANG, {}).get(s, s)


def sh(cmd, timeout=30):
    # On timeout the child must be KILLED: communicate() only raises, the
    # process lives on. In the daemon this once left four hung macmon
    # instances and a stalled loop; here it would be the same, only quieter.
    p = None
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        out, _ = p.communicate(timeout=timeout)
        return out.decode("utf-8", "replace")
    except Exception:
        if p is not None and p.poll() is None:
            try:
                p.kill()
                p.communicate(timeout=2)
            except Exception:
                pass
        return ""


def abs_epoch(s):
    """Absolute epoch from a stamp with or without a UTC offset (pre-2.1.8 files).

    Deliberate copy of `guard.abs_epoch`: the CLI tools in this project are
    self-contained and never import the daemon. Both copies are kept in sync
    by `tests/test_spojnosc.py`.

    Without this, events were filtered by the absolute `epoch` field while
    history and guard.log were filtered by TEXT interpreted in the READER's
    timezone, so the same data directory produced two different evidence
    documents: a crash recorded at 23:30 in Warsaw vanished from the critical
    section when read in Auckland, while the timeline and the `[KILL]` from
    the same second stayed.
    """
    # Evidence-file parser: it must NEVER raise, one garbage row cannot take
    # down the whole document. An earlier version narrowed the `except` to
    # (ValueError, OverflowError) and lost resilience to non-strings: the
    # fuzzer caught it immediately (123 -> AttributeError, b"..." -> TypeError).
    if not isinstance(s, str):
        return 0
    s = s.strip()
    if len(s) < 19:
        return 0
    try:
        if len(s) >= 24 and s[19] in "+-":
            return datetime.datetime.strptime(s[:24], "%Y-%m-%d %H:%M:%S%z").timestamp()
        return time.mktime(time.strptime(s[:19], "%Y-%m-%d %H:%M:%S"))
    except Exception:      # noqa: BLE001 - contract: never raises
        return 0


KNOWN_FLAGS = ("--help", "-h", "--days", "--pdf", "--file", "--from", "--to", "--all")


def free_name(path):
    """Return a path that is GUARANTEED not to overwrite someone's file.

    `--pdf` derives the PDF name from the report name, so `--file results.txt`
    targeted `results.pdf` and deleted it if the user already had one -
    overwritten without a word. Instead of asking (the report also runs from
    cron and from the menu bar), pick a free name and print it at the end.
    """
    if not os.path.exists(path):
        return path
    base, ext = os.path.splitext(path)
    for n in range(2, 1000):
        candidate = "%s-%d%s" % (base, n, ext)
        if not os.path.exists(candidate):
            return candidate
    return path


def generations(path):
    """Return the current file plus rotated generations, OLDEST FIRST.

    Deliberate copy of `guard.generations`: the CLI tools in this project are
    self-contained and never import the daemon. Both copies are kept in sync
    by `tests/test_spojnosc.py`; change one, change the other.
    """
    rotated = []
    n = 1
    while True:
        p = "%s.%d" % (path, n)
        if not os.path.exists(p):
            break
        rotated.append(p)
        n += 1
    rotated.reverse()                    # .3, .2, .1 = chronologicznie
    if os.path.exists(path):
        rotated.append(path)
    return rotated


def iter_lines(path, skip_header=False):
    """Lines from the current file AND all rotated generations, in order.

    The guard rotates `guard.log` and `history.csv` at 5 MB. This report used
    to read ONLY the current file, so rotation silently cut the evidence
    document's history: before rotation "PEAK MEASURED CHIP TEMPERATURE:
    98.7 C", after rotation the same `--days 2` reported 44.0 C - while the
    98.7 C reading still sat on disk in the `.1` file nobody looked at.
    """
    for p in generations(path):
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                if skip_header:
                    f.readline()
                for line in f:
                    yield line
        except OSError:
            continue


def _alarms_from_log(in_range):
    """Cooling alarms from guard.log that are absent from events.log (old installs).

    `in_range` is passed in from main(), where it closes over the report
    boundaries.
    """
    out = []
    try:
        for line in iter_lines(LOG):
            if ("[FANFAIL]" not in line and "AWARIA CHLODZENIA" not in line
                    and "COOLING FAILURE" not in line):
                continue
            if not in_range(abs_epoch(line[:24])):
                continue
            out.append(line.rstrip())
    except Exception:
        pass
    return out


def main():
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__)
        return 0
    # An unknown flag must NOT silently generate a report on the Desktop.
    # `thermal-report --help` used to do exactly that: it wrote the file and
    # exited 0.
    unknown_flags = [a for a in sys.argv[1:] if a.startswith("-") and a not in KNOWN_FLAGS]
    if unknown_flags:
        print(T("thermal-report: unknown argument: %s") % " ".join(unknown_flags), file=sys.stderr)
        print(__doc__, file=sys.stderr)
        return 2

    days = 7
    for flag in ("--days",):
        if flag in sys.argv:
            # A bad range must NOT be accepted silently. `--days` without a
            # number and `--days abc` used to exit 0 with a report for the
            # DEFAULT 7 days - a document describing a different period than
            # ordered, without saying a word. In an evidence document that is
            # a false negative: "nothing happened in this period".
            try:
                days = int(sys.argv[sys.argv.index(flag) + 1])
            except (IndexError, ValueError):
                print(T("thermal-report: %s needs a number of days") % flag, file=sys.stderr)
                return 2
            if days < 1:
                print(T("thermal-report: number of days must be 1 or more (got %s)") % days,
                      file=sys.stderr)
                return 2
            break
    target = None
    for flag in ("--file", "--plik"):
        if flag in sys.argv:
            try:
                target = sys.argv[sys.argv.index(flag) + 1]
            except IndexError:
                pass
            break
    if target is None:
        target = os.path.join(HOME, "Desktop",
                           "thermal_report_%s.txt" % time.strftime("%Y%m%d_%H%M"))
    # NOTE for the next reader: `target` does NOT go through free_name() while
    # the PDF does - deliberate, not an oversight. The text file name is given
    # by the user (`--file`), so they may expect exactly that name; swapping
    # in "report-2.txt" would break every script and cron entry. Nobody
    # chooses the PDF name - it is derived from the report name, so a
    # collision with someone's file is UNINTENDED and invisible. We protect
    # against the name the user never chose. The default name carries a
    # to-the-minute stamp, so by itself it does not collide.

    def _data(s):
        return time.mktime(time.strptime(s, "%Y-%m-%d"))

    # range: --all (everything), --from/--to YYYY-MM-DD (calendar), or --days N
    lower_bound = time.time() - days * 86400
    upper_bound = None
    range_description = T("range: last %d days") % days
    if "--all" in sys.argv:
        lower_bound = 0
        range_description = T("range: everything on record")
    if "--from" in sys.argv:
        try:
            lower_bound = _data(sys.argv[sys.argv.index("--from") + 1])
        except (IndexError, ValueError, OverflowError):
            # a typo in the date silently fell back to "last 7 days" and the
            # header printed a range nobody asked for
            print(T("thermal-report: --from needs a date as YYYY-MM-DD"), file=sys.stderr)
            return 2
    if "--to" in sys.argv:
        try:
            # A DST-transition day has 23 or 25 hours. Adding a flat 86400 s
            # to midnight produced 23:00 of the same day (autumn) or 01:00 of
            # the next (spring) - on the transition night the report lost a
            # whole day INCLUDING A CRASH, and in spring the header printed a
            # date nobody asked about.
            _txt = sys.argv[sys.argv.index("--to") + 1]
            _d = datetime.datetime.strptime(_txt, "%Y-%m-%d").date() + datetime.timedelta(days=1)
            upper_bound = time.mktime(_d.timetuple())
        except (IndexError, ValueError, OverflowError):
            print(T("thermal-report: --to needs a date as YYYY-MM-DD"), file=sys.stderr)
            return 2
    if upper_bound is not None and lower_bound >= upper_bound:
        # a reversed range produced an EMPTY report with exit 0 - it reads as
        # "nothing happened in this period" but only means the range has no length
        print(T("thermal-report: the range ends before it starts (--from is after --to)"),
              file=sys.stderr)
        return 2
    if "--from" in sys.argv or "--to" in sys.argv:
        range_description = T("range: %s - %s") % (
            time.strftime("%Y-%m-%d", time.localtime(lower_bound)),
            time.strftime("%Y-%m-%d", time.localtime((upper_bound - 1 if upper_bound else time.time()))))

    def in_range(t):
        # `t < upper_bound`, not `<=`: upper_bound is midnight of the NEXT day, so with <=
        # a one-day report included the first entry of the following day -
        # including a "peak temperature" attributed to a day it was not on.
        return t >= lower_bound and (upper_bound is None or t < upper_bound)

    W = []

    W.append(T("coffee-paladin - THERMAL AND POWER REPORT"))
    W.append(T("generated: %s") % time.strftime("%Y-%m-%d %H:%M:%S") + "   " + range_description)
    W.append("=" * 78)

    W.append(T("\n## HARDWARE\n"))
    for line in sh(["system_profiler", "SPHardwareDataType"]).splitlines():
        if re.search(r"Model Name|Model Identifier|Chip|Total Number of Cores|Memory|Serial", line):
            W.append("  " + line.strip())

    # same data set as "About my Mac": macOS, configuration date, fans, disk,
    # Neural Engine, thresholds
    try:
        hw = json.load(open(os.path.join(BASE, "hardware.json")))
        if not isinstance(hw, dict):
            hw = {}          # valid JSON but a list or text: hw.get() would kill the report
    except Exception:
        hw = {}
    W.append("  macOS: " + sh(["sw_vers", "-productVersion"]).strip())
    try:
        st = os.stat("/var/db/.AppleSetupDone")
        W.append(T("  system set up: %s") % time.strftime("%Y-%m-%d", time.localtime(st.st_birthtime)))
    except Exception:
        pass
    if hw.get("fan_count") is not None:
        W.append(T("  fans: %s") % hw.get("fan_count"))
    chip_hw = hw.get("chip") or ""
    if chip_hw:
        W.append(T("  Neural Engine: %d cores") % (32 if "Ultra" in chip_hw else 16))
    df = sh(["df", "-g", "/"]).splitlines()
    if len(df) > 1 and len(df[1].split()) >= 5:
        k = df[1].split()
        W.append(T("  disk: %s GB total, %s GB free") % (k[1], k[3]))
    try:
        cfg_j = json.load(open(CFG))
        W.append(T("  guard thresholds: pause >=%s C, kill >=%s C") % (
            cfg_j.get("soc_pause_c", "?"), cfg_j.get("soc_kill_c", "?")))
    except Exception:
        pass

    W.append(T("\n## BATTERY\n"))
    for line in sh(["system_profiler", "SPPowerDataType"]).splitlines()[:40]:
        if re.search(r"Cycle Count|Condition|Maximum Capacity|Charging|State of Charge|Serial", line):
            W.append("  " + line.strip())
    ioreg = sh(["ioreg", "-r", "-c", "AppleSmartBattery", "-d", "1", "-w", "0"])
    for key in ("MaximumTemperature", "PermanentFailureStatus", "CycleCount", "Voltage"):
        m = re.search(r'"%s"\s*=\s*(\d+)' % key, ioreg)
        if m:
            W.append("  %s = %s" % (key, m.group(1)))

    # --- najwazniejsza czesc: twarde pady
    W.append(T("\n## CRITICAL EVENTS (hard shutdowns, cooling alarms)\n"))
    event_count = 0
    _seen_alarms = []     # czasy alarmow z events.log — do deduplikacji tych z guard.log
    _entries = []          # (time, lines) — sekcja krytyczna musi byc CHRONOLOGICZNA
    try:
        for line in iter_lines(EVENTS):
            try:
                z = json.loads(line)
            except Exception:
                continue
            if not isinstance(z, dict):
                continue
            if z.get("synthetic"):
                continue          # test entries do not belong in service evidence
            # `epoch` is unambiguous; `time` is text without a timezone, so an
            # entry read in another timezone could fall out of the range.
            event_time = z.get("epoch")
            if not isinstance(event_time, (int, float)):
                event_time = abs_epoch(z.get("time", ""))
            if not in_range(event_time):
                continue
            event_count += 1
            if "COOLING" in str(z.get("type", "")):
                _seen_alarms.append(event_time)
            _entry_lines = ["  [%s] %s — %s" % (z.get("time"), z.get("type"), z.get("description"))]
            context = z.get("context")
            readings = context.get("last_readings") if isinstance(context, dict) else []
            readings = [x for x in (readings or []) if isinstance(x, dict)]
            if readings:
                _entry_lines.append(T("      readings immediately before the event:"))
                for p in readings:
                    _entry_lines.append("        %s  chip %s C  fan %s rpm  %s W  battery %s%%  %s  load %s"
                             % (p.get("time", "?"), p.get("chip_C", "?"),
                                p.get("fan_rpm", "?"), p.get("watts", "?"),
                                p.get("battery_pct", "?"),
                                (T("AC") if p.get("on_ac") == "1" else T("battery")) if p.get("on_ac") is not None else "?",
                                p.get("load1", "?")))
            _entries.append((event_time, _entry_lines))
    except FileNotFoundError:
        pass
    # Fan alarms reach events.log only on newer installs. For older ones we
    # pull them from guard.log, so the critical section cannot claim "no
    # alarms" while listing them a few dozen lines below in the same document.
    # On current installs a cooling alarm goes to BOTH guard.log and
    # events.log; the log reader exists for installs predating that change,
    # so it must skip what already came from events.log - otherwise every
    # alarm counts TWICE in a warranty-claim document.
    for line in _alarms_from_log(in_range):
        _t = abs_epoch(line[:24])
        if any(abs(_t - e) <= 2 for e in _seen_alarms):
            continue
        event_count += 1
        _entries.append((_t, ["  " + line]))
    # events.log is ordered by DETECTION, not occurrence (a crash is detected
    # after the restart), and guard.log alarms used to be appended at the end.
    # The reader could not reconstruct causality - did the fans stop first,
    # or did the Mac crash first.
    for _, _l in sorted(_entries, key=lambda x: x[0]):
        W.extend(_l)
    if not event_count:
        W.append(T("  (none - no hard shutdown or cooling alarm was detected in this period)"))

    W.append(T("\n## SHUTDOWN CAUSES REPORTED BY THE SYSTEM\n"))
    output = sh(["pmset", "-g", "log"], timeout=60)
    matches = [l for l in output.splitlines() if "shutdown cause" in l.lower()][-10:]
    W.extend("  " + l.strip() for l in matches) if matches else W.append(
        T("  (no 'Previous shutdown cause' entries - typical after a loss of power)"))

    W.append(T("\n## GUARD INTERVENTIONS\n"))
    inter = 0
    try:
        for line in iter_lines(LOG):
            if not in_range(abs_epoch(line[:24])):
                continue
            # Tags are the parser contract (see guard.log()): identical in every
            # language, so intervention matching needs no word lists.
            if re.search(r"\[(PAUSE|RESUME|KILL|DEMOTE|PROMOTE|FANFAIL|CRASH)\]", line):
                inter += 1
                W.append("  " + line.rstrip())
    except FileNotFoundError:
        pass
    if not inter:
        W.append(T("  (none)"))

    W.append(T("\n## MEASUREMENT TIMELINE\n"))
    W.append(T("  time, state, chip C, GPU C, battery C, fan rpm, W, battery %, on AC, CPU limit, load, level"))
    measurement_count = 0
    peak = (0, "")
    rejected_count, rejected_max = 0, 0.0
    timeline_rows = []
    try:
        for line in iter_lines(HIST, skip_header=True):
            c = line.strip().split(",")
            if len(c) < 12 or not in_range(abs_epoch(c[0])):
                continue
            measurement_count += 1
            try:
                # Physical range: one truncated row after a power loss used to
                # replace the document's key number with "999.9 C (CORRUPTED ROW)".
                #
                # The upper bound is 110 C, not 150: Apple Silicon Tj max sits
                # around 105-110 C and the guard's kill threshold at 100 C. A
                # 120 C reading means a broken sensor, not hotter silicon -
                # and in a warranty-claim document it is a gift to the other
                # side ("your data is worthless").
                #
                # An out-of-band row is NOT skipped silently: it still sits
                # further down the timeline, so silence made the document
                # contradict itself - "PEAK 88.8 C" right above a visible
                # 999.9 C row. Evidence gets FLAGGED, not thrown away.
                v = float(c[2]) if c[2] else 0.0
                if v != v:                       # NaN
                    pass
                elif 0.0 < v <= 110.0 and abs_epoch(c[0]):
                    if v > peak[0]:
                        peak = (v, c[0])
                elif v > 110.0 and v != float("inf"):
                    rejected_count += 1
                    rejected_max = max(rejected_max, v)
            except (ValueError, OverflowError):
                pass
            # collect into a list instead of appending right away: only with
            # the whole set do we know which rows are HOT and thus must
            # survive truncation
            try:
                level = int(float(c[11])) if c[11] else 0
            except (ValueError, IndexError):
                level = 0
            timeline_rows.append(("  " + ", ".join(c[:12]), v if v == v else 0.0, level))
    except FileNotFoundError:
        pass

    # --- the timeline can grow unmanageable ----------------------------------------
    # Full history is 5 MB per file x 6 generations. Measured: `--all` produced
    # a 27 MB / 341,975-line report, about 6200 PDF pages - a document that
    # size cannot be sent or printed, and `--pdf` on it invites trouble.
    # We truncate but do NOT lose evidence: ALL rows hotter than 10 C below
    # the peak and all rows with a nonzero intervention level stay, the rest
    # is sampled evenly. And we say so explicitly - silent truncation would be
    # the same bug as silently dropping corrupted rows.
    hot_threshold = max(0.0, peak[0] - 10.0)
    truncated_count = 0
    if len(timeline_rows) > MAX_TIMELINE_ROWS:
        important_indices = [i for i, (_, v, lv) in enumerate(timeline_rows) if v >= hot_threshold > 0 or lv > 0]
        budget = max(1, MAX_TIMELINE_ROWS - len(important_indices))
        rest_indices = [i for i in range(len(timeline_rows)) if i not in set(important_indices)]
        step = max(1, len(rest_indices) // budget) if rest_indices else 1
        selected_indices = sorted(set(important_indices) | set(rest_indices[::step]))
        truncated_count = len(timeline_rows) - len(selected_indices)
        timeline_rows = [timeline_rows[i] for i in selected_indices]
    for row_text, _v, _lv in timeline_rows:
        W.append(row_text)
    # NO MEASUREMENTS is not the same as NO EVENTS. With an empty data
    # directory the document filled with "(none - not detected...)" lines and
    # an empty timeline, so it looked like proof of a HEALTHY machine - while
    # it only meant nobody was measuring (daemon not running, data deleted,
    # or the range predates the install). In a warranty-claim document that
    # difference is fundamental, so we state it AT THE TOP where it cannot be
    # missed, not as an empty table at the bottom.
    if measurement_count == 0:
        W.insert(3, "")
        W.insert(4, T("  !! NO MEASUREMENTS IN THIS RANGE. This document does NOT show that "
                      "nothing happened -\n     it shows that nothing was recorded. Possible "
                      "reasons: the guard was not running,\n     the data was deleted, or the "
                      "range predates the installation."))

    timeline_header = []
    if truncated_count:
        timeline_header.append(
            T("  TIMELINE SHORTENED: showing %d of %d measurements. Every reading within 10 C "
              "of the peak\n     and every reading with an intervention was kept; the calm rest "
              "is sampled evenly.\n     Full data: history.csv (and its rotated generations).")
            % (len(timeline_rows), len(timeline_rows) + truncated_count))
    if peak[0]:
        timeline_header.append(T("  PEAK MEASURED CHIP TEMPERATURE: %.1f C (%s)") % peak)
    if rejected_count:
        timeline_header.append(
            T("  DISCARDED AS IMPLAUSIBLE: %d row(s) over 110 C (highest %.1f C) - shown in "
              "the timeline below, not counted towards the peak") % (rejected_count, rejected_max))
    # one insertion, so the order does not depend on how many lines happen to go in
    W[len(W) - measurement_count - 1:len(W) - measurement_count - 1] = timeline_header

    W.append("\n" + "=" * 78)
    try:
        interval = int(json.load(open(CFG)).get("poll_seconds", 15))
    except Exception:
        interval = 15
    W.append(T("Measurements are collected by the algorithm every %d s (written every 5 min and on every event).") % interval)
    W.append(T("Chip temperature is read through IOReport, battery temperature through AppleSmartBattery."))
    W.append("")
    W.append("coffee-paladin v%s  ·  Shield the Process, Sip the Coffee" % VERSION)
    W.append("https://github.com/pawelkwaczynski/coffee-paladin")
    W.append("FOCUS FRAME")

    content = "\n".join(W) + "\n"
    try:
        with os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            f.write(content)
    except OSError as e:
        # This tool runs exactly when the disk is full or right after a crash -
        # a traceback is the worst possible answer then.
        print(T("thermal-report: cannot write %s (%s)") % (target, e), file=sys.stderr)
        return 1

    # PDF via the system cupsfilter (textutil cannot write PDF - verified).
    # Monospace matches the text source; on failure the text report still
    # exists and we print the path to what we have.
    if "--pdf" in sys.argv:
        # os.path.splitext, not rsplit("."): rsplit caught a dot in the
        # DIRECTORY name, so `--file dir.with.dot/report` wrote the PDF one
        # level up under a different name. NEVER write straight to the target:
        # `open(pdf,"wb")` truncated someone's file to 0 B before anything was
        # generated, and `--print-to-pdf` overwrote it entirely. Generate next
        # to it, swap in only after success.
        pdf = free_name(os.path.splitext(target)[0] + ".pdf")
        _fd_pdf, tmp_pdf = tempfile.mkstemp(suffix=".pdf", prefix=".thermal_report_",
                                            dir=os.path.dirname(os.path.abspath(pdf)) or ".")
        os.close(_fd_pdf)
        # FIRST CHOICE: HTML -> headless Chrome. Only this path can embed the
        # COLOR footer logo (cupsfilter handles plain text only).
        chrome = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
        logo = os.path.join(BASE, "logo_footer.png")
        if os.path.exists(chrome):
            try:
                import base64
                import html as _html
                html_content = _html.escape(content.rsplit("FOCUS FRAME", 1)[0].rstrip())
                footer = ""
                if os.path.exists(logo):
                    with open(logo, "rb") as f:
                        b64 = base64.b64encode(f.read()).decode()
                    footer = ('<div class="stopka"><img src="data:image/png;base64,%s"></div>'
                              % b64)
                doc = ("""<!doctype html><meta charset="utf-8"><style>
@page { margin: 14mm 12mm; }
body { font: 8.5pt ui-monospace, "SF Mono", Menlo, monospace; color: #111; }
pre { white-space: pre-wrap; word-break: break-word; margin: 0; }
.stopka { margin-top: 10mm; text-align: center; }
.stopka img { width: 42mm; }
</style><pre>%s</pre>%s""" % (html_content, footer))
                # The intermediate HTML goes to a temp directory. It used to be
                # created NEXT TO the target and deleted without asking:
                # `--pdf --file report.txt` overwrote and REMOVED someone's
                # report.html.
                _fd, tmp_html = tempfile.mkstemp(suffix=".html", prefix="thermal_report_")
                os.close(_fd)
                with open(tmp_html, "w") as f:
                    f.write(doc)
                r = subprocess.run([chrome, "--headless", "--disable-gpu", "--no-pdf-header-footer",
                                    "--print-to-pdf=" + tmp_pdf, "file://" + tmp_html],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=180)
                os.remove(tmp_html)
                if r.returncode == 0 and os.path.exists(tmp_pdf) and os.path.getsize(tmp_pdf) > 1000:
                    os.replace(tmp_pdf, pdf)
                    print(pdf)
                    return 0
            except Exception:
                try:
                    os.remove(tmp_html)   # a Chrome timeout left an orphaned HTML
                except Exception:
                    pass
        # FALLBACK: cupsfilter (no logo, but always works)
        try:
            with open(tmp_pdf, "wb") as f:
                r = subprocess.run(["cupsfilter", target], stdout=f,
                                   stderr=subprocess.DEVNULL, timeout=120)
            if r.returncode == 0 and os.path.getsize(tmp_pdf) > 1000:
                os.replace(tmp_pdf, pdf)
                print(pdf)
                return 0
        except Exception:
            pass
        # remove OUR OWN working file - never the target. This used to be
        # `os.remove(pdf)`, deleting a file that could belong to someone else.
        try:
            os.remove(tmp_pdf)
        except OSError:
            pass
    print(target)
    return 0


if __name__ == "__main__":
    sys.exit(main())
