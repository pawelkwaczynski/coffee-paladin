DICTS = {"pl": PL, "ru": RU, "zh": ZH, "es": ES}


def T(s):
    return DICTS.get(LANG, {}).get(s, s)


def sh(cmd, timeout=30):
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        out, _ = p.communicate(timeout=timeout)
        return out.decode("utf-8", "replace")
    except Exception:
        return ""


def czas_z(s):
    try:
        return time.mktime(time.strptime(s, "%Y-%m-%d %H:%M:%S"))
    except Exception:
        return 0


def main():
    dni = 7
    for flaga in ("--days", "--dni"):          # --dni zostaje dla zgodnosci
        if flaga in sys.argv:
            try:
                dni = int(sys.argv[sys.argv.index(flaga) + 1])
            except Exception:
                pass
            break
    cel = None
    for flaga in ("--file", "--plik"):
        if flaga in sys.argv:
            try:
                cel = sys.argv[sys.argv.index(flaga) + 1]
            except IndexError:
                pass
            break
    if cel is None:
        cel = os.path.join(HOME, "Desktop",
                           "thermal_report_%s.txt" % time.strftime("%Y%m%d_%H%M"))

    def _data(s):
        return time.mktime(time.strptime(s, "%Y-%m-%d"))

    # zakres: --all (calosc), --from/--to YYYY-MM-DD (kalendarz), albo --days N
    granica = time.time() - dni * 86400
    gorna = None
    zakres_opis = T("range: last %d days") % dni
    if "--all" in sys.argv:
        granica = 0
        zakres_opis = T("range: everything on record")
    if "--from" in sys.argv:
        try:
            granica = _data(sys.argv[sys.argv.index("--from") + 1])
        except Exception:
            pass
    if "--to" in sys.argv:
        try:
            gorna = _data(sys.argv[sys.argv.index("--to") + 1]) + 86400
        except Exception:
            pass
    if "--from" in sys.argv or "--to" in sys.argv:
        zakres_opis = T("range: %s - %s") % (
            time.strftime("%Y-%m-%d", time.localtime(granica)),
            time.strftime("%Y-%m-%d", time.localtime((gorna or time.time()))))

    def w_zakresie(t):
        return t >= granica and (gorna is None or t <= gorna)

    W = []

    W.append(T("coffee-paladin - THERMAL AND POWER REPORT"))
    W.append(T("generated: %s") % time.strftime("%Y-%m-%d %H:%M:%S") + "   " + zakres_opis)
    W.append("=" * 78)

    W.append(T("\n## HARDWARE\n"))
    for linia in sh(["system_profiler", "SPHardwareDataType"]).splitlines():
        if re.search(r"Model Name|Model Identifier|Chip|Total Number of Cores|Memory|Serial", linia):
            W.append("  " + linia.strip())

    # komplet danych jak w "O moim Macu" (pkt 7): macOS, data konfiguracji,
    # wentylatory, dysk, Neural Engine, progi
    try:
        hw = json.load(open(os.path.join(BASE, "hardware.json")))
    except Exception:
        hw = {}
    W.append("  macOS: " + sh(["sw_vers", "-productVersion"]).strip())
    try:
        st = os.stat("/var/db/.AppleSetupDone")
        W.append(T("  system set up: %s") % time.strftime("%Y-%m-%d", time.localtime(st.st_birthtime)))
    except Exception:
        pass
    if hw.get("fan_count") is not None:
        W.append(T("  fans: %s") % hw.get("fan_count"))
    chip_hw = hw.get("chip") or ""
    if chip_hw:
        W.append(T("  Neural Engine: %d cores") % (32 if "Ultra" in chip_hw else 16))
    df = sh(["df", "-g", "/"]).splitlines()
    if len(df) > 1 and len(df[1].split()) >= 5:
        k = df[1].split()
        W.append(T("  disk: %s GB total, %s GB free") % (k[1], k[3]))
    try:
        cfg_j = json.load(open(CFG))
        W.append(T("  guard thresholds: pause >=%s C, kill >=%s C") % (
            cfg_j.get("soc_pause_c", "?"), cfg_j.get("soc_kill_c", "?")))
    except Exception:
        pass

    W.append(T("\n## BATTERY\n"))
    for linia in sh(["system_profiler", "SPPowerDataType"]).splitlines()[:40]:
        if re.search(r"Cycle Count|Condition|Maximum Capacity|Charging|State of Charge|Serial", linia):
            W.append("  " + linia.strip())
    ioreg = sh(["ioreg", "-r", "-c", "AppleSmartBattery", "-d", "1", "-w", "0"])
    for klucz in ("MaximumTemperature", "PermanentFailureStatus", "CycleCount", "Voltage"):
        m = re.search(r'"%s"\s*=\s*(\d+)' % klucz, ioreg)
        if m:
            W.append("  %s = %s" % (klucz, m.group(1)))

    # --- najwazniejsza czesc: twarde pady
    W.append(T("\n## CRITICAL EVENTS (hard shutdowns, cooling alarms)\n"))
    zdarzen = 0
    try:
        with open(EVENTS) as f:
            for linia in f:
                try:
                    z = json.loads(linia)
                except Exception:
                    continue
                if not isinstance(z, dict):
                    continue
                if z.get("synthetic"):
                    continue          # wpisy testowe nie wchodza do dowodu dla serwisu
                if not w_zakresie(czas_z(z.get("time", ""))):
                    continue
                zdarzen += 1
                W.append("  [%s] %s — %s" % (z.get("time"), z.get("type"), z.get("description")))
                kontekst = z.get("context")
                pomiary = kontekst.get("last_readings") if isinstance(kontekst, dict) else []
                pomiary = [x for x in (pomiary or []) if isinstance(x, dict)]
                if pomiary:
                    W.append(T("      readings immediately before the event:"))
                    for p in pomiary:
                        W.append("        %s  chip %s C  wentylator %s obr/min  %s W  bateria %s%%  %s  load %s"
                                 % (p.get("time", "?"), p.get("chip_C", "?"),
                                    p.get("fan_rpm", "?"), p.get("watts", "?"),
                                    p.get("battery_pct", "?"),
                                    T("AC") if p.get("on_ac") == "1" else T("battery"),
                                    p.get("load1", "?")))
    except FileNotFoundError:
        pass
    if not zdarzen:
        W.append(T("  (none - no hard shutdown or cooling alarm was detected in this period)"))

    W.append(T("\n## SHUTDOWN CAUSES REPORTED BY THE SYSTEM\n"))
    wy = sh(["pmset", "-g", "log"], timeout=60)
    trafienia = [l for l in wy.splitlines() if "shutdown cause" in l.lower()][-10:]
    W.extend("  " + l.strip() for l in trafienia) if trafienia else W.append(
        T("  (no 'Previous shutdown cause' entries - typical after a loss of power)"))

    W.append(T("\n## GUARD INTERVENTIONS\n"))
    inter = 0
    try:
        with open(LOG) as f:
            for linia in f:
                if not w_zakresie(czas_z(linia[:19])):
                    continue
                # Znacznik [PAUSE]/[RESUME]/[KILL]/[DEMOTE]/[PROMOTE]/[FANFAIL] jest ten sam we
                # wszystkich jezykach. Slowa zostaja dla wpisow sprzed jego wprowadzenia:
                # bez nich raport z maszyny rosyjskiej gubil kazdy wykryty twardy pad.
                if re.search(r"\[(PAUSE|RESUME|KILL|DEMOTE|PROMOTE|FANFAIL)\]"
                             r"|PAUSED|RESUMED|PAUZA|WZNOWIONE|SIGTERM|TERMINAT|koncze zadanie"
                             r"|AWARIA|FAILURE|HARD SHUT|TWARDY|ОБНАРУЖЕНО|检测到硬关机|APAGADO BRUSCO", linia):
                    inter += 1
                    W.append("  " + linia.rstrip())
    except FileNotFoundError:
        pass
    if not inter:
        W.append(T("  (none)"))

    W.append(T("\n## MEASUREMENT TIMELINE\n"))
    W.append(T("  time, state, chip C, GPU C, battery C, fan rpm, W, battery %, on AC, CPU limit, load, level"))
    ile = 0
    szczyt = (0, "")
    try:
        with open(HIST) as f:
            f.readline()                  # naglowek CSV - pomijamy
            for linia in f:
                c = linia.strip().split(",")
                if len(c) < 12 or not w_zakresie(czas_z(c[0])):
                    continue
                ile += 1
                try:
                    # Zakres fizyczny: jedna ucieta linijka po padzie zasilania podmieniala
                    # kluczowa liczbe dokumentu na "999.9 C (USZKODZONY WIERSZ)".
                    v = float(c[2]) if c[2] else 0.0
                    if 0.0 < v <= 120.0 and v > szczyt[0] and czas_z(c[0]):
                        szczyt = (v, c[0])
                except ValueError:
                    pass
                W.append("  " + ", ".join(c[:12]))
    except FileNotFoundError:
        pass
    if szczyt[0]:
        W.insert(len(W) - ile - 2, T("  PEAK MEASURED CHIP TEMPERATURE: %.1f C (%s)") % szczyt)

    W.append("\n" + "=" * 78)
    try:
        interwal = int(json.load(open(CFG)).get("poll_seconds", 15))
    except Exception:
        interwal = 15
    W.append(T("Measurements are collected by the algorithm every %d s (written every 5 min and on every event).") % interwal)
    W.append(T("Chip temperature is read through IOReport, battery temperature through AppleSmartBattery."))
    W.append("")
    W.append("coffee-paladin v%s  ·  Shield the Process, Sip the Coffee" % VERSION)
    W.append("https://github.com/pawelkwaczynski/coffee-paladin")
    W.append("FOCUS FRAME")

    tekst = "\n".join(W) + "\n"
    with open(cel, "w") as f:
        f.write(tekst)

    # PDF przez systemowy cupsfilter (textutil nie umie pisac PDF — sprawdzone).
    # Monospace zostaje z natury zrodla tekstowego; gdy sie nie uda, raport tekstowy
    # nadal istnieje i drukujemy sciezke tego, co jest.
    if "--pdf" in sys.argv:
        # os.path.splitext, nie rsplit(".") - rsplit lapal kropke z nazwy KATALOGU,
        # wiec `--file kat.z.kropka/raport` zapisywalo PDF poziom wyzej, pod inna nazwa.
        pdf = os.path.splitext(cel)[0] + ".pdf"
        # PIERWSZA DROGA: HTML -> Chrome headless. Tylko tak wchodzi KOLOROWE logo
        # FOCUS FRAME w stopce (cupsfilter potrafi wylacznie czysty tekst).
        chrome = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
        logo = os.path.join(BASE, "logo_footer.png")
        if os.path.exists(chrome):
            try:
                import base64
                import html as _html
                tresc = _html.escape(tekst.rsplit("FOCUS FRAME", 1)[0].rstrip())
                stopka = ""
                if os.path.exists(logo):
                    with open(logo, "rb") as f:
                        b64 = base64.b64encode(f.read()).decode()
                    stopka = ('<div class="stopka"><img src="data:image/png;base64,%s"></div>'
                              % b64)
                doc = ("""<!doctype html><meta charset="utf-8"><style>
@page { margin: 14mm 12mm; }
body { font: 8.5pt ui-monospace, "SF Mono", Menlo, monospace; color: #111; }
pre { white-space: pre-wrap; word-break: break-word; margin: 0; }
.stopka { margin-top: 10mm; text-align: center; }
.stopka img { width: 42mm; }
</style><pre>%s</pre>%s""" % (tresc, stopka))
                # HTML posredni idzie do katalogu tymczasowego. Wczesniej powstawal OBOK
                # celu i byl kasowany bez pytania: `--pdf --file raport.txt` nadpisywalo
                # i USUWALO czyjs raport.html. Do tego rsplit(".") lapal kropke z nazwy
                # KATALOGU, wiec PDF potrafil wyladowac poza katalogiem docelowym.
                _fd, tmp_html = tempfile.mkstemp(suffix=".html", prefix="thermal_report_")
                os.close(_fd)
                with open(tmp_html, "w") as f:
                    f.write(doc)
                r = subprocess.run([chrome, "--headless", "--disable-gpu", "--no-pdf-header-footer",
                                    "--print-to-pdf=" + pdf, "file://" + tmp_html],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=180)
                os.remove(tmp_html)
                if r.returncode == 0 and os.path.exists(pdf) and os.path.getsize(pdf) > 1000:
                    print(pdf)
                    return 0
            except Exception:
                try:
