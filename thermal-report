#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""thermal-report - a single evidence file for a repair shop or a warranty claim.

Assembles what is normally missing after a hard shutdown, when the system log simply ends
at the moment the machine died: the guard's measurement timeline (chip temperature, fan rpm,
power draw, power source), detected hard shutdowns together with the readings that preceded
them, every intervention the guard made, and the hardware state.

Usage:
  thermal-report                    # last 7 days -> ~/Desktop (plain text)
  thermal-report --days 30
  thermal-report --pdf              # additionally render a PDF next to the text file
  thermal-report --file /path/report.txt

Language: TG_LANG=en|pl, or "lang" in ~/.thermal-guard/config.json. Default: en.
"""

import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
BASE = os.path.join(HOME, ".thermal-guard")
HIST = os.path.join(BASE, "history.csv")
EVENTS = os.path.join(BASE, "events.log")
LOG = os.path.join(BASE, "guard.log")
CFG = os.path.join(BASE, "config.json")


def _lang():
    v = (os.environ.get("TG_LANG") or "").lower()[:2]
    if v in ("pl", "en"):
        return v
    try:
        with open(CFG) as f:
            v = (json.load(f).get("lang") or "").lower()[:2]
        if v in ("pl", "en"):
            return v
    except Exception:
        pass
    return "en"


LANG = _lang()

PL = {
    "THERMAL AND POWER REPORT - Mac": "RAPORT TERMICZNY I ZASILANIA - Mac",
    "generated: %s   range: last %d days": "wygenerowano: %s   zakres: ostatnie %d dni",
    "\n## HARDWARE\n": "\n## SPRZET\n",
    "\n## BATTERY\n": "\n## BATERIA\n",
    "\n## CRITICAL EVENTS (hard shutdowns, cooling alarms)\n":
        "\n## ZDARZENIA KRYTYCZNE (twarde wylaczenia, alarmy chlodzenia)\n",
    "  (none - no hard shutdown or cooling alarm was detected in this period)":
        "  (brak - w tym okresie nie wykryto twardego wylaczenia ani alarmu chlodzenia)",
    "      readings immediately before the event:": "      odczyty bezposrednio przed zdarzeniem:",
    "\n## SHUTDOWN CAUSES REPORTED BY THE SYSTEM\n": "\n## POWODY WYLACZEN WG SYSTEMU\n",
    "  (no 'Previous shutdown cause' entries - typical after a loss of power)":
        "  (brak wpisow 'Previous shutdown cause' - typowe przy utracie zasilania)",
    "\n## GUARD INTERVENTIONS\n": "\n## INTERWENCJE BEZPIECZNIKA\n",
    "  (none)": "  (brak)",
    "\n## MEASUREMENT TIMELINE\n": "\n## OS CZASU POMIAROW\n",
    "  time, chip C, GPU C, battery C, fan rpm, W, battery %, on AC, CPU limit, load, level":
        "  czas, chip C, GPU C, bateria C, obroty, W, bateria %, zasilacz, CPU limit, load, poziom",
    "  PEAK MEASURED CHIP TEMPERATURE: %.1f C (%s)": "  NAJWYZSZA ZMIERZONA TEMPERATURA CHIPA: %.1f C (%s)",
    "Measurements are collected by thermal-guard every 15 s (written every 5 min and on every event).":
        "Pomiary zbiera thermal-guard co 15 s (zapis co 5 min oraz przy kazdym zdarzeniu).",
    "Chip temperature is read through IOReport, battery temperature through AppleSmartBattery.":
        "Temperatura chipa czytana przez IOReport, temperatura baterii przez AppleSmartBattery.",
    "AC": "zasilacz",
    "battery": "bateria",
}


def T(s):
    return PL.get(s, s) if LANG == "pl" else s


def sh(cmd, timeout=30):
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        out, _ = p.communicate(timeout=timeout)
        return out.decode("utf-8", "replace")
    except Exception:
        return ""


def czas_z(s):
    try:
        return time.mktime(time.strptime(s, "%Y-%m-%d %H:%M:%S"))
    except Exception:
        return 0


def main():
    dni = 7
    for flaga in ("--days", "--dni"):          # --dni zostaje dla zgodnosci
        if flaga in sys.argv:
            try:
                dni = int(sys.argv[sys.argv.index(flaga) + 1])
            except Exception:
                pass
            break
    cel = None
    for flaga in ("--file", "--plik"):
        if flaga in sys.argv:
            cel = sys.argv[sys.argv.index(flaga) + 1]
            break
    if cel is None:
        cel = os.path.join(HOME, "Desktop",
                           "thermal_report_%s.txt" % time.strftime("%Y%m%d_%H%M"))
    granica = time.time() - dni * 86400
    W = []

    W.append(T("THERMAL AND POWER REPORT - Mac"))
    W.append(T("generated: %s   range: last %d days") % (
        time.strftime("%Y-%m-%d %H:%M:%S"), dni))
    W.append("=" * 78)

    W.append(T("\n## HARDWARE\n"))
    for linia in sh(["system_profiler", "SPHardwareDataType"]).splitlines():
        if re.search(r"Model Name|Model Identifier|Chip|Total Number of Cores|Memory|Serial", linia):
            W.append("  " + linia.strip())

    W.append(T("\n## BATTERY\n"))
    for linia in sh(["system_profiler", "SPPowerDataType"]).splitlines()[:40]:
        if re.search(r"Cycle Count|Condition|Maximum Capacity|Charging|State of Charge|Serial", linia):
            W.append("  " + linia.strip())
    ioreg = sh(["ioreg", "-r", "-c", "AppleSmartBattery", "-d", "1", "-w", "0"])
    for klucz in ("MaximumTemperature", "PermanentFailureStatus", "CycleCount", "Voltage"):
        m = re.search(r'"%s"\s*=\s*(\d+)' % klucz, ioreg)
        if m:
            W.append("  %s = %s" % (klucz, m.group(1)))

    # --- najwazniejsza czesc: twarde pady
    W.append(T("\n## CRITICAL EVENTS (hard shutdowns, cooling alarms)\n"))
    zdarzen = 0
    try:
        with open(EVENTS) as f:
            for linia in f:
                try:
                    z = json.loads(linia)
                except Exception:
                    continue
                if czas_z(z.get("time", "")) < granica:
                    continue
                zdarzen += 1
                W.append("  [%s] %s — %s" % (z.get("time"), z.get("type"), z.get("description")))
                pomiary = (z.get("context") or {}).get("last_readings") or []
                if pomiary:
                    W.append(T("      readings immediately before the event:"))
                    for p in pomiary:
                        W.append("        %s  chip %s C  wentylator %s obr/min  %s W  bateria %s%%  %s  load %s"
                                 % (p.get("time", "?"), p.get("chip_C", "?"),
                                    p.get("fan_rpm", "?"), p.get("watts", "?"),
                                    p.get("battery_pct", "?"),
                                    T("AC") if p.get("on_ac") == "1" else T("battery"),
                                    p.get("load1", "?")))
    except FileNotFoundError:
        pass
    if not zdarzen:
        W.append(T("  (none - no hard shutdown or cooling alarm was detected in this period)"))

    W.append(T("\n## SHUTDOWN CAUSES REPORTED BY THE SYSTEM\n"))
    wy = sh(["pmset", "-g", "log"], timeout=60)
    trafienia = [l for l in wy.splitlines() if "shutdown cause" in l.lower()][-10:]
    W.extend("  " + l.strip() for l in trafienia) if trafienia else W.append(
        T("  (no 'Previous shutdown cause' entries - typical after a loss of power)"))

    W.append(T("\n## GUARD INTERVENTIONS\n"))
    inter = 0
    try:
        with open(LOG) as f:
            for linia in f:
                if czas_z(linia[:19]) < granica:
                    continue
                if re.search(r"PAUSED|RESUMED|PAUZA|WZNOWIONE|SIGTERM|TERMINAT|koncze zadanie|AWARIA|FAILURE|HARD SHUT|TWARDY", linia):
                    inter += 1
                    W.append("  " + linia.rstrip())
    except FileNotFoundError:
        pass
    if not inter:
        W.append(T("  (none)"))

    W.append(T("\n## MEASUREMENT TIMELINE\n"))
    W.append(T("  time, chip C, GPU C, battery C, fan rpm, W, battery %, on AC, CPU limit, load, level"))
    ile = 0
    szczyt = (0, "")
    try:
        with open(HIST) as f:
            naglowek = f.readline()
            for linia in f:
                c = linia.strip().split(",")
                if len(c) < 12 or czas_z(c[0]) < granica:
                    continue
                ile += 1
                try:
                    if c[2] and float(c[2]) > szczyt[0]:
                        szczyt = (float(c[2]), c[0])
                except ValueError:
                    pass
                W.append("  " + ", ".join(c[:12]))
    except FileNotFoundError:
        pass
    if szczyt[0]:
        W.insert(len(W) - ile - 2, T("  PEAK MEASURED CHIP TEMPERATURE: %.1f C (%s)") % szczyt)

    W.append("\n" + "=" * 78)
    W.append(T("Measurements are collected by thermal-guard every 15 s (written every 5 min and on every event)."))
    W.append(T("Chip temperature is read through IOReport, battery temperature through AppleSmartBattery."))

    tekst = "\n".join(W) + "\n"
    with open(cel, "w") as f:
        f.write(tekst)

    # PDF przez systemowy cupsfilter (textutil nie umie pisac PDF — sprawdzone).
    # Monospace zostaje z natury zrodla tekstowego; gdy sie nie uda, raport tekstowy
    # nadal istnieje i drukujemy sciezke tego, co jest.
    if "--pdf" in sys.argv:
        pdf = cel.rsplit(".", 1)[0] + ".pdf"
        try:
            with open(pdf, "wb") as f:
                r = subprocess.run(["cupsfilter", cel], stdout=f,
                                   stderr=subprocess.DEVNULL, timeout=120)
            if r.returncode == 0 and os.path.getsize(pdf) > 1000:
                print(pdf)
                return 0
            os.remove(pdf)
        except Exception:
            pass
    print(cel)
    return 0


if __name__ == "__main__":
    sys.exit(main())
