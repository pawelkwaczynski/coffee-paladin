    p = None
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        out, _ = p.communicate(timeout=timeout)
        return out.decode("utf-8", "replace")
    except Exception:
        if p is not None and p.poll() is None:
            try:
                p.kill()
                p.communicate(timeout=2)
            except Exception:
                pass
        return ""


def czas_z(s):
    """Epoch ABSOLUTNY ze stempla z offsetem albo bez (pliki sprzed 2.1.8).

    CELOWA KOPIA `guard.czas_abs` - narzedzia w tym projekcie sa samodzielne i nie
    importuja demona. Obie kopie pilnuje `tests/test_spojnosc.py`.

    Bez tego zdarzenia byly filtrowane po polu `epoch` (absolutnym), a historia
    i guard.log po TEKSCIE interpretowanym w strefie CZYTELNIKA - wiec ten sam
    katalog danych dawal dwa rozne dokumenty dowodowe. Odtworzone 02.08.2026:
    pad zapisany 23:30 w Warszawie znikal z sekcji krytycznej przy czytaniu
    w Auckland, a os czasu i `[KILL]` z tej samej sekundy zostawaly.
    """
    # Parser danych z pliku dowodowego: MA nigdy nie rzucac, bo jeden smieciowy wiersz
    # nie moze wywalic calego dokumentu. Pierwsza wersja tej funkcji zawezila `except`
    # do (ValueError, OverflowError) i stracila odpornosc na nie-stringi - fuzzer
    # rundy 1 zlapal to od razu: wejscie 123 dawalo AttributeError, b"..." TypeError.
    if not isinstance(s, str):
        return 0
    s = s.strip()
    if len(s) < 19:
        return 0
    try:
        if len(s) >= 24 and s[19] in "+-":
            return datetime.datetime.strptime(s[:24], "%Y-%m-%d %H:%M:%S%z").timestamp()
        return time.mktime(time.strptime(s[:19], "%Y-%m-%d %H:%M:%S"))
    except Exception:      # noqa: BLE001 - kontrakt: nigdy nie rzuca
        return 0


ZNANE_FLAGI = ("--help", "-h", "--days", "--dni", "--pdf", "--file", "--from", "--to", "--all")


def wolna_nazwa(sciezka):
    """Sciezka, ktora NA PEWNO nie nadpisze cudzego pliku.

    `--pdf` sklada nazwe PDF-a z nazwy raportu, wiec `--file wyniki.txt` celowal
    w `wyniki.pdf` - i kasowal go, jesli ktos juz taki mial. Odtworzone 02.08.2026
    na cudzym pliku: nadpisany bez slowa. Zamiast pytac (raport bywa uruchamiany
    z crona i z menu paska) bierzemy wolna nazwe i drukujemy ja na koncu.
    """
    if not os.path.exists(sciezka):
        return sciezka
    baza, roz = os.path.splitext(sciezka)
    for n in range(2, 1000):
        kandydat = "%s-%d%s" % (baza, n, roz)
        if not os.path.exists(kandydat):
            return kandydat
    return sciezka


def pokolenia(path):
    """Plik biezacy razem ze zrotowanymi pokoleniami, OD NAJSTARSZEGO.

    CELOWA KOPIA `guard.pokolenia` - narzedzia w tym projekcie sa samodzielne i nie
    importuja demona. Obie kopie pilnuje `tests/test_spojnosc.py`; zmieniasz jedna,
    zmien druga.
    """
    zrotowane = []
    n = 1
    while True:
        p = "%s.%d" % (path, n)
        if not os.path.exists(p):
            break
        zrotowane.append(p)
        n += 1
    zrotowane.reverse()                    # .3, .2, .1 = chronologicznie
    if os.path.exists(path):
        zrotowane.append(path)
    return zrotowane


def wiersze(path, pomijaj_naglowek=False):
    """Linie z pliku biezacego I ze wszystkich zrotowanych pokolen, chronologicznie.

    Guard rotuje `guard.log` i `history.csv` przy 5 MB. Ten raport czytal WYLACZNIE
    plik biezacy, wiec rotacja po cichu ucinala dokumentowi dowodowemu historie.
    Odtworzone 02.08.2026: przed rotacja "PEAK MEASURED CHIP TEMPERATURE: 98.7 C",
    po rotacji ten sam `--days 2` dawal 44,0 C - a odczyt 98,7 C dalej lezal na dysku,
    tyle ze w pliku `.1`, do ktorego nikt nie zagladal.
    """
    for p in pokolenia(path):
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                if pomijaj_naglowek:
                    f.readline()
                for linia in f:
                    yield linia
        except OSError:
            continue


def _alarmy_z_logu(w_zakresie):
    """Alarmy chlodzenia z guard.log, ktorych nie ma w events.log (instalacje sprzed 02.08).

    `w_zakresie` przekazywane z main(), bo tam jest domkniete na granicach raportu.
    """
    out = []
    try:
        for linia in wiersze(LOG):
            if ("[FANFAIL]" not in linia and "AWARIA CHLODZENIA" not in linia
                    and "COOLING FAILURE" not in linia):
                continue
            if not w_zakresie(czas_z(linia[:24])):
                continue
            out.append(linia.rstrip())
    except Exception:
        pass
    return out


def main():
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__)
        return 0
    # Nieznana flaga NIE moze po cichu wygenerowac raportu na Pulpicie. Wczesniej
    # `thermal-report --help` robilo dokladnie to: zapisywalo plik i konczylo kodem 0.
    obce = [a for a in sys.argv[1:] if a.startswith("-") and a not in ZNANE_FLAGI]
    if obce:
        print(T("thermal-report: unknown argument: %s") % " ".join(obce), file=sys.stderr)
        print(__doc__, file=sys.stderr)
        return 2

    dni = 7
    for flaga in ("--days", "--dni"):          # --dni zostaje dla zgodnosci
        if flaga in sys.argv:
            # Zly zakres NIE moze byc przyjety po cichu. `--days` bez liczby i
            # `--days abc` konczyly sie kodem 0 i raportem za DOMYSLNE 7 dni - czyli
            # dokument opisywal inny okres niz zamowiony, nie mowiac o tym ani slowa.
            # W dokumencie dowodowym to falszywy negatyw: "w tym okresie nic nie bylo".
            try:
                dni = int(sys.argv[sys.argv.index(flaga) + 1])
            except (IndexError, ValueError):
                print(T("thermal-report: %s needs a number of days") % flaga, file=sys.stderr)
                return 2
            if dni < 1:
                print(T("thermal-report: number of days must be 1 or more (got %s)") % dni,
                      file=sys.stderr)
                return 2
            break
    cel = None
    for flaga in ("--file", "--plik"):
        if flaga in sys.argv:
            try:
                cel = sys.argv[sys.argv.index(flaga) + 1]
            except IndexError:
                pass
            break
    if cel is None:
        cel = os.path.join(HOME, "Desktop",
                           "thermal_report_%s.txt" % time.strftime("%Y%m%d_%H%M"))
    # UWAGA dla nastepnego czytelnika: `cel` NIE przechodzi przez wolna_nazwa(), a PDF tak -
    # i to jest celowe, nie przeoczenie. Nazwe pliku tekstowego uzytkownik podaje SAM
    # (`--file`), wiec ma prawo oczekiwac dokladnie jej; podmiana na "raport-2.txt"
    # zepsulaby kazdy skrypt i wpis w cronie. Nazwy PDF-a nikt nie wybiera - jest
    # wyprowadzana z nazwy raportu, wiec kolizja z cudzym plikiem jest NIEZAMIERZONA
    # i niewidoczna. Chronimy przed nazwa, ktorej uzytkownik nie wybieral.
    # Nazwa domyslna niesie znacznik do minuty, wiec sama z siebie nie koliduje.

    def _data(s):
        return time.mktime(time.strptime(s, "%Y-%m-%d"))

    # zakres: --all (calosc), --from/--to YYYY-MM-DD (kalendarz), albo --days N
    granica = time.time() - dni * 86400
    gorna = None
    zakres_opis = T("range: last %d days") % dni
    if "--all" in sys.argv:
        granica = 0
        zakres_opis = T("range: everything on record")
    if "--from" in sys.argv:
        try:
            granica = _data(sys.argv[sys.argv.index("--from") + 1])
        except (IndexError, ValueError, OverflowError):
            # literowka w dacie spadala po cichu na "ostatnie 7 dni" i drukowala
            # w naglowku zakres, o ktory nikt nie prosil
            print(T("thermal-report: --from needs a date as YYYY-MM-DD"), file=sys.stderr)
            return 2
    if "--to" in sys.argv:
        try:
            # Doba przy zmianie czasu ma 23 albo 25 godzin. Dodanie stalych 86400 s
            # do polnocy dawalo 23:00 tej samej doby (jesien) albo 01:00 doby
            # nastepnej (wiosna) - w noc zmiany czasu raport gubil caly dzien
            # RAZEM Z PADEM, a wiosna drukowal w naglowku date, o ktora nikt nie pytal.
            _txt = sys.argv[sys.argv.index("--to") + 1]
            _d = datetime.datetime.strptime(_txt, "%Y-%m-%d").date() + datetime.timedelta(days=1)
            gorna = time.mktime(_d.timetuple())
        except (IndexError, ValueError, OverflowError):
            print(T("thermal-report: --to needs a date as YYYY-MM-DD"), file=sys.stderr)
            return 2
    if gorna is not None and granica >= gorna:
        # odwrocony zakres dawal PUSTY raport z kodem 0 - czyta sie go jak "w tym
        # okresie nic sie nie dzialo", a znaczy tylko tyle, ze zakres nie ma dlugosci
        print(T("thermal-report: the range ends before it starts (--from is after --to)"),
              file=sys.stderr)
        return 2
    if "--from" in sys.argv or "--to" in sys.argv:
        zakres_opis = T("range: %s - %s") % (
            time.strftime("%Y-%m-%d", time.localtime(granica)),
            time.strftime("%Y-%m-%d", time.localtime((gorna - 1 if gorna else time.time()))))

    def w_zakresie(t):
        # `t < gorna`, nie `<=`: gorna to polnoc NASTEPNEJ doby, wiec przy <= do raportu
        # za jeden dzien wchodzil pierwszy wpis z dnia kolejnego - lacznie ze "szczytem
        # temperatury", ktory byl przypisywany do dnia, w ktorym go nie bylo.
        return t >= granica and (gorna is None or t < gorna)

    W = []

    W.append(T("coffee-paladin - THERMAL AND POWER REPORT"))
    W.append(T("generated: %s") % time.strftime("%Y-%m-%d %H:%M:%S") + "   " + zakres_opis)
    W.append("=" * 78)

    W.append(T("\n## HARDWARE\n"))
    for linia in sh(["system_profiler", "SPHardwareDataType"]).splitlines():
        if re.search(r"Model Name|Model Identifier|Chip|Total Number of Cores|Memory|Serial", linia):
            W.append("  " + linia.strip())

    # komplet danych jak w "O moim Macu" (pkt 7): macOS, data konfiguracji,
    # wentylatory, dysk, Neural Engine, progi
    try:
        hw = json.load(open(os.path.join(BASE, "hardware.json")))
        if not isinstance(hw, dict):
            hw = {}          # poprawny JSON, ale lista albo tekst - hw.get() by wywalilo raport
    except Exception:
        hw = {}
    W.append("  macOS: " + sh(["sw_vers", "-productVersion"]).strip())
    try:
        st = os.stat("/var/db/.AppleSetupDone")
        W.append(T("  system set up: %s") % time.strftime("%Y-%m-%d", time.localtime(st.st_birthtime)))
    except Exception:
        pass
    if hw.get("fan_count") is not None:
        W.append(T("  fans: %s") % hw.get("fan_count"))
    chip_hw = hw.get("chip") or ""
    if chip_hw:
        W.append(T("  Neural Engine: %d cores") % (32 if "Ultra" in chip_hw else 16))
    df = sh(["df", "-g", "/"]).splitlines()
    if len(df) > 1 and len(df[1].split()) >= 5:
        k = df[1].split()
        W.append(T("  disk: %s GB total, %s GB free") % (k[1], k[3]))
    try:
        cfg_j = json.load(open(CFG))
        W.append(T("  guard thresholds: pause >=%s C, kill >=%s C") % (
            cfg_j.get("soc_pause_c", "?"), cfg_j.get("soc_kill_c", "?")))
    except Exception:
        pass

    W.append(T("\n## BATTERY\n"))
    for linia in sh(["system_profiler", "SPPowerDataType"]).splitlines()[:40]:
        if re.search(r"Cycle Count|Condition|Maximum Capacity|Charging|State of Charge|Serial", linia):
            W.append("  " + linia.strip())
    ioreg = sh(["ioreg", "-r", "-c", "AppleSmartBattery", "-d", "1", "-w", "0"])
    for klucz in ("MaximumTemperature", "PermanentFailureStatus", "CycleCount", "Voltage"):
        m = re.search(r'"%s"\s*=\s*(\d+)' % klucz, ioreg)
        if m:
            W.append("  %s = %s" % (klucz, m.group(1)))

    # --- najwazniejsza czesc: twarde pady
    W.append(T("\n## CRITICAL EVENTS (hard shutdowns, cooling alarms)\n"))
    zdarzen = 0
    _juz_alarmy = []     # czasy alarmow z events.log — do deduplikacji tych z guard.log
    _wpisy = []          # (czas, linie) — sekcja krytyczna musi byc CHRONOLOGICZNA
    try:
        for linia in wiersze(EVENTS):
            try:
                z = json.loads(linia)
            except Exception:
                continue
            if not isinstance(z, dict):
                continue
            if z.get("synthetic"):
                continue          # wpisy testowe nie wchodza do dowodu dla serwisu
            # `epoch` (od 02.08.2026) jest jednoznaczny; `time` to tekst bez strefy,
            # wiec przy odczycie w innej strefie wpis potrafil wypasc z zakresu.
            t_zdarzenia = z.get("epoch")
            if not isinstance(t_zdarzenia, (int, float)):
                t_zdarzenia = czas_z(z.get("time", ""))
            if not w_zakresie(t_zdarzenia):
                continue
            zdarzen += 1
            if "COOLING" in str(z.get("type", "")):
                _juz_alarmy.append(t_zdarzenia)
            _linie = ["  [%s] %s — %s" % (z.get("time"), z.get("type"), z.get("description"))]
            kontekst = z.get("context")
            pomiary = kontekst.get("last_readings") if isinstance(kontekst, dict) else []
            pomiary = [x for x in (pomiary or []) if isinstance(x, dict)]
            if pomiary:
                _linie.append(T("      readings immediately before the event:"))
                for p in pomiary:
                    _linie.append("        %s  chip %s C  wentylator %s obr/min  %s W  bateria %s%%  %s  load %s"
                             % (p.get("time", "?"), p.get("chip_C", "?"),
                                p.get("fan_rpm", "?"), p.get("watts", "?"),
                                p.get("battery_pct", "?"),
                                (T("AC") if p.get("on_ac") == "1" else T("battery")) if p.get("on_ac") is not None else "?",
                                p.get("load1", "?")))
            _wpisy.append((t_zdarzenia, _linie))
    except FileNotFoundError:
        pass
    # Alarmy wentylatorow trafiaja do events.log dopiero od 02.08.2026. Dla starszych
    # instalacji dociagamy je z guard.log, zeby sekcja krytyczna nie twierdzila
    # "brak alarmow", majac je wypisane kilkadziesiat linii nizej w tym samym dokumencie.
    # Od 02.08 alarm chlodzenia idzie i do guard.log, i do events.log. Czytnik logu
    # istnieje dla instalacji SPRZED tej zmiany, wiec musi pomijac to, co juz przyszlo
    # z events.log - inaczej kazdy alarm liczy sie DWA razy w dokumencie roszczeniowym.
    for linia in _alarmy_z_logu(w_zakresie):
        _t = czas_z(linia[:24])
        if any(abs(_t - e) <= 2 for e in _juz_alarmy):
            continue
        zdarzen += 1
        _wpisy.append((_t, ["  " + linia]))
    # events.log jest w kolejnosci WYKRYCIA, nie zajscia (pad wykrywa sie po restarcie),
    # a alarmy z guard.log doklejaly sie zawsze na koncu. Czytelnik nie mogl odtworzyc
    # przyczynowosci - czy najpierw stanely wentylatory, czy najpierw padl Mac.
    for _, _l in sorted(_wpisy, key=lambda x: x[0]):
        W.extend(_l)
    if not zdarzen:
        W.append(T("  (none - no hard shutdown or cooling alarm was detected in this period)"))

    W.append(T("\n## SHUTDOWN CAUSES REPORTED BY THE SYSTEM\n"))
    wy = sh(["pmset", "-g", "log"], timeout=60)
    trafienia = [l for l in wy.splitlines() if "shutdown cause" in l.lower()][-10:]
    W.extend("  " + l.strip() for l in trafienia) if trafienia else W.append(
        T("  (no 'Previous shutdown cause' entries - typical after a loss of power)"))

    W.append(T("\n## GUARD INTERVENTIONS\n"))
    inter = 0
    try:
        for linia in wiersze(LOG):
            if not w_zakresie(czas_z(linia[:24])):
                continue
            # Znacznik [PAUSE]/[RESUME]/[KILL]/[DEMOTE]/[PROMOTE]/[FANFAIL] jest ten sam we
            # wszystkich jezykach. Slowa zostaja dla wpisow sprzed jego wprowadzenia:
            # bez nich raport z maszyny rosyjskiej gubil kazdy wykryty twardy pad.
            if re.search(r"\[(PAUSE|RESUME|KILL|DEMOTE|PROMOTE|FANFAIL)\]"
                         r"|PAUSED|RESUMED|PAUZA|WZNOWIONE|SIGTERM|TERMINAT|koncze zadanie|DEMOTE|PROMOTE"
                         r"|AWARIA|FAILURE|HARD SHUT|TWARDY|ОБНАРУЖЕНО|检测到硬关机|APAGADO BRUSCO", linia):
                inter += 1
                W.append("  " + linia.rstrip())
    except FileNotFoundError:
        pass
    if not inter:
        W.append(T("  (none)"))

    W.append(T("\n## MEASUREMENT TIMELINE\n"))
    W.append(T("  time, state, chip C, GPU C, battery C, fan rpm, W, battery %, on AC, CPU limit, load, level"))
    ile = 0
    szczyt = (0, "")
    odrzucone, odrzucony_max = 0, 0.0
    osie = []
    try:
        for linia in wiersze(HIST, pomijaj_naglowek=True):
            c = linia.strip().split(",")
            if len(c) < 12 or not w_zakresie(czas_z(c[0])):
                continue
            ile += 1
            try:
                # Zakres fizyczny: jedna ucieta linijka po padzie zasilania podmieniala
                # kluczowa liczbe dokumentu na "999.9 C (USZKODZONY WIERSZ)".
                #
                # Gorna granica to 110 C, nie 150: T_j max Apple Silicon lezy przy
                # ~105-110 C, a prog ubicia guarda przy 100 C. Odczyt 120 C znaczy
                # zepsuty czujnik, nie gorety krzem - a w dokumencie roszczeniowym
                # jest prezentem dla drugiej strony ("wasze dane sa bez wartosci").
                #
                # Wiersza poza pasmem NIE pomijamy po cichu: on i tak stoi nizej na osi
                # czasu, wiec milczenie robilo z dokumentu cos, co samo sobie przeczy -
                # "PEAK 88.8 C" tuz nad widoczna linijka 999.9 C. Dowod ma byc
                # OZNACZONY, nie wyrzucony (ta sama lekcja co podloga 30-dniowa).
                v = float(c[2]) if c[2] else 0.0
                if v != v:                       # NaN
                    pass
                elif 0.0 < v <= 110.0 and czas_z(c[0]):
                    if v > szczyt[0]:
                        szczyt = (v, c[0])
                elif v > 110.0 and v != float("inf"):
                    odrzucone += 1
                    odrzucony_max = max(odrzucony_max, v)
            except (ValueError, OverflowError):
                pass
            # zbieramy do listy zamiast dopisywac od razu: dopiero majac calosc wiemy,
            # ktore wiersze sa GORACE, a wiec ktorych nie wolno wyrzucic przy skracaniu
            try:
                poziom = int(float(c[11])) if c[11] else 0
            except (ValueError, IndexError):
                poziom = 0
            osie.append(("  " + ", ".join(c[:12]), v if v == v else 0.0, poziom))
    except FileNotFoundError:
        pass

    # --- os czasu bywa nie do uniesienia -------------------------------------------
    # Pelna historia to 5 MB na plik x 6 pokolen. Zmierzone: `--all` dawal raport
    # 27 MB / 341 975 linii, czyli ~6200 stron PDF - dokumentu tej wielkosci nie da sie
    # nikomu wyslac ani wydrukowac, a `--pdf` na nim to zaproszenie do problemow.
    # Skracamy, ale NIE gubimy dowodu: zostaja WSZYSTKIE wiersze goretsze niz 10 C
    # ponizej szczytu i wszystkie z niezerowym poziomem interwencji, reszta jest
    # probkowana rownomiernie. I mowimy o tym wprost - skrocenie po cichu byloby tym
    # samym bledem, co ciche odrzucanie wierszy z pozycji 5.
    prog_goracy = max(0.0, szczyt[0] - 10.0)
    skrocono = 0
    if len(osie) > MAX_WIERSZY_OSI:
        istotne = [i for i, (_, v, lv) in enumerate(osie) if v >= prog_goracy > 0 or lv > 0]
        budzet = max(1, MAX_WIERSZY_OSI - len(istotne))
        reszta = [i for i in range(len(osie)) if i not in set(istotne)]
        krok = max(1, len(reszta) // budzet) if reszta else 1
        wybrane = sorted(set(istotne) | set(reszta[::krok]))
        skrocono = len(osie) - len(wybrane)
        osie = [osie[i] for i in wybrane]
    for tekst_wiersza, _v, _lv in osie:
        W.append(tekst_wiersza)
    # BRAK POMIAROW to nie to samo co BRAK ZDARZEN. Przy pustym katalogu danych dokument
    # wypelnial sie samymi "(brak - nie wykryto...)" i pusta osia czasu, czyli wygladal
    # jak dowod ZDROWIA maszyny - a znaczyl tylko tyle, ze nikt niczego nie mierzyl
    # (demon nie dzialal, dane skasowano, albo zakres jest sprzed instalacji).
    # W dokumencie roszczeniowym to roznica fundamentalna, wiec mowimy o niej NA GORZE,
    # gdzie nie da sie jej przeoczyc, a nie na dole pusta tabelka.
    if ile == 0:
        W.insert(3, "")
        W.insert(4, T("  !! NO MEASUREMENTS IN THIS RANGE. This document does NOT show that "
                      "nothing happened -\n     it shows that nothing was recorded. Possible "
                      "reasons: the guard was not running,\n     the data was deleted, or the "
                      "range predates the installation."))

    naglowek_osi = []
    if skrocono:
        naglowek_osi.append(
            T("  TIMELINE SHORTENED: showing %d of %d measurements. Every reading within 10 C "
              "of the peak\n     and every reading with an intervention was kept; the calm rest "
              "is sampled evenly.\n     Full data: history.csv (and its rotated generations).")
            % (len(osie), len(osie) + skrocono))
    if szczyt[0]:
        naglowek_osi.append(T("  PEAK MEASURED CHIP TEMPERATURE: %.1f C (%s)") % szczyt)
    if odrzucone:
        naglowek_osi.append(
            T("  DISCARDED AS IMPLAUSIBLE: %d row(s) over 110 C (highest %.1f C) - shown in "
              "the timeline below, not counted towards the peak") % (odrzucone, odrzucony_max))
    # jedna wstawka, zeby kolejnosc nie zalezala od tego, ile linijek akurat wchodzi
    W[len(W) - ile - 1:len(W) - ile - 1] = naglowek_osi

    W.append("\n" + "=" * 78)
    try:
        interwal = int(json.load(open(CFG)).get("poll_seconds", 15))
    except Exception:
        interwal = 15
    W.append(T("Measurements are collected by the algorithm every %d s (written every 5 min and on every event).") % interwal)
    W.append(T("Chip temperature is read through IOReport, battery temperature through AppleSmartBattery."))
    W.append("")
    W.append("coffee-paladin v%s  ·  Shield the Process, Sip the Coffee" % VERSION)
    W.append("https://github.com/pawelkwaczynski/coffee-paladin")
    W.append("FOCUS FRAME")

    tekst = "\n".join(W) + "\n"
    try:
        with os.fdopen(os.open(cel, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            f.write(tekst)
    except OSError as e:
        # To narzedzie odpala sie dokladnie wtedy, gdy dysk jest pelny albo po padzie -
        # traceback jest wtedy najgorsza mozliwa odpowiedzia.
        print(T("thermal-report: cannot write %s (%s)") % (cel, e), file=sys.stderr)
        return 1

    # PDF przez systemowy cupsfilter (textutil nie umie pisac PDF — sprawdzone).
    # Monospace zostaje z natury zrodla tekstowego; gdy sie nie uda, raport tekstowy
    # nadal istnieje i drukujemy sciezke tego, co jest.
    if "--pdf" in sys.argv:
        # os.path.splitext, nie rsplit(".") - rsplit lapal kropke z nazwy KATALOGU,
        # wiec `--file kat.z.kropka/raport` zapisywalo PDF poziom wyzej, pod inna nazwa.
        # NIGDY nie piszemy wprost do celu: `open(pdf,"wb")` obcinal cudzy plik do 0 B,
        # zanim cokolwiek zdazylo sie wygenerowac, a `--print-to-pdf` nadpisywal go
        # w calosci. Generujemy obok, podmieniamy dopiero po sukcesie.
        pdf = wolna_nazwa(os.path.splitext(cel)[0] + ".pdf")
        _fd_pdf, tmp_pdf = tempfile.mkstemp(suffix=".pdf", prefix=".thermal_report_",
                                            dir=os.path.dirname(os.path.abspath(pdf)) or ".")
        os.close(_fd_pdf)
        # PIERWSZA DROGA: HTML -> Chrome headless. Tylko tak wchodzi KOLOROWE logo
        # FOCUS FRAME w stopce (cupsfilter potrafi wylacznie czysty tekst).
        chrome = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
        logo = os.path.join(BASE, "logo_footer.png")
        if os.path.exists(chrome):
            try:
                import base64
                import html as _html
                tresc = _html.escape(tekst.rsplit("FOCUS FRAME", 1)[0].rstrip())
                stopka = ""
                if os.path.exists(logo):
                    with open(logo, "rb") as f:
                        b64 = base64.b64encode(f.read()).decode()
                    stopka = ('<div class="stopka"><img src="data:image/png;base64,%s"></div>'
                              % b64)
                doc = ("""<!doctype html><meta charset="utf-8"><style>
@page { margin: 14mm 12mm; }
body { font: 8.5pt ui-monospace, "SF Mono", Menlo, monospace; color: #111; }
pre { white-space: pre-wrap; word-break: break-word; margin: 0; }
.stopka { margin-top: 10mm; text-align: center; }
.stopka img { width: 42mm; }
</style><pre>%s</pre>%s""" % (tresc, stopka))
                # HTML posredni idzie do katalogu tymczasowego. Wczesniej powstawal OBOK
                # celu i byl kasowany bez pytania: `--pdf --file raport.txt` nadpisywalo
                # i USUWALO czyjs raport.html. Do tego rsplit(".") lapal kropke z nazwy
                # KATALOGU, wiec PDF potrafil wyladowac poza katalogiem docelowym.
                _fd, tmp_html = tempfile.mkstemp(suffix=".html", prefix="thermal_report_")
                os.close(_fd)
                with open(tmp_html, "w") as f:
                    f.write(doc)
                r = subprocess.run([chrome, "--headless", "--disable-gpu", "--no-pdf-header-footer",
                                    "--print-to-pdf=" + tmp_pdf, "file://" + tmp_html],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=180)
                os.remove(tmp_html)
                if r.returncode == 0 and os.path.exists(tmp_pdf) and os.path.getsize(tmp_pdf) > 1000:
                    os.replace(tmp_pdf, pdf)
                    print(pdf)
                    return 0
            except Exception:
                try:
                    os.remove(tmp_html)   # timeout Chrome zostawial osierocony HTML
                except Exception:
                    pass
        # ZAPAS: cupsfilter (bez logo, ale zawsze dziala)
        try:
            with open(tmp_pdf, "wb") as f:
                r = subprocess.run(["cupsfilter", cel], stdout=f,
                                   stderr=subprocess.DEVNULL, timeout=120)
            if r.returncode == 0 and os.path.getsize(tmp_pdf) > 1000:
                os.replace(tmp_pdf, pdf)
                print(pdf)
                return 0
        except Exception:
            pass
        # kasujemy WLASNY plik roboczy - nigdy celu. Wczesniej stalo tu
        # `os.remove(pdf)`, czyli usuniecie pliku, ktory mogl nalezec do kogos innego.
        try:
            os.remove(tmp_pdf)
        except OSError:
            pass
    print(cel)
    return 0


if __name__ == "__main__":
    sys.exit(main())
