#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""thermal-report — jeden plik z dowodami dla serwisu Apple.

Sklada w calosc to, czego zabraklo przy incydencie 29.07.2026, gdy dziennik systemowy
urwal sie w chwili zgasniecia: os czasu pomiarow guarda (temperatura chipa, obroty
wentylatorow, pobor, zasilanie), wykryte twarde pady wraz z odczytami sprzed padu,
interwencje bezpiecznika oraz stan sprzetu.

Uzycie:
  thermal-report                 # raport z ostatnich 7 dni -> ~/Desktop
  thermal-report --dni 30
  thermal-report --plik /sciezka/raport.txt
"""

import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
BASE = os.path.join(HOME, ".thermal-guard")
HIST = os.path.join(BASE, "history.csv")
EVENTS = os.path.join(BASE, "events.log")
LOG = os.path.join(BASE, "guard.log")


def sh(cmd, timeout=30):
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        out, _ = p.communicate(timeout=timeout)
        return out.decode("utf-8", "replace")
    except Exception:
        return ""


def czas_z(s):
    try:
        return time.mktime(time.strptime(s, "%Y-%m-%d %H:%M:%S"))
    except Exception:
        return 0


def main():
    dni = 7
    if "--dni" in sys.argv:
        try:
            dni = int(sys.argv[sys.argv.index("--dni") + 1])
        except Exception:
            pass
    if "--plik" in sys.argv:
        cel = sys.argv[sys.argv.index("--plik") + 1]
    else:
        cel = os.path.join(HOME, "Desktop",
                           "raport_termiczny_%s.txt" % time.strftime("%Y%m%d_%H%M"))
    granica = time.time() - dni * 86400
    W = []

    W.append("RAPORT TERMICZNY I ZASILANIA — MacBook Pro")
    W.append("wygenerowano: %s   zakres: ostatnie %d dni" % (
        time.strftime("%Y-%m-%d %H:%M:%S"), dni))
    W.append("=" * 78)

    W.append("\n## SPRZET\n")
    for linia in sh(["system_profiler", "SPHardwareDataType"]).splitlines():
        if re.search(r"Model Name|Model Identifier|Chip|Total Number of Cores|Memory|Serial", linia):
            W.append("  " + linia.strip())

    W.append("\n## BATERIA\n")
    for linia in sh(["system_profiler", "SPPowerDataType"]).splitlines()[:40]:
        if re.search(r"Cycle Count|Condition|Maximum Capacity|Charging|State of Charge|Serial", linia):
            W.append("  " + linia.strip())
    ioreg = sh(["ioreg", "-r", "-c", "AppleSmartBattery", "-d", "1", "-w", "0"])
    for klucz in ("MaximumTemperature", "PermanentFailureStatus", "CycleCount", "Voltage"):
        m = re.search(r'"%s"\s*=\s*(\d+)' % klucz, ioreg)
        if m:
            W.append("  %s = %s" % (klucz, m.group(1)))

    # --- najwazniejsza czesc: twarde pady
    W.append("\n## ZDARZENIA KRYTYCZNE (twarde wylaczenia, alarmy chlodzenia)\n")
    zdarzen = 0
    try:
        with open(EVENTS) as f:
            for linia in f:
                try:
                    z = json.loads(linia)
                except Exception:
                    continue
                if czas_z(z.get("czas", "")) < granica:
                    continue
                zdarzen += 1
                W.append("  [%s] %s — %s" % (z.get("czas"), z.get("rodzaj"), z.get("opis")))
                pomiary = (z.get("kontekst") or {}).get("ostatnie_pomiary") or []
                if pomiary:
                    W.append("      odczyty bezposrednio przed zdarzeniem:")
                    for p in pomiary:
                        W.append("        %s  chip %s C  wentylator %s obr/min  %s W  bateria %s%%  %s  load %s"
                                 % (p.get("czas", "?"), p.get("chip_C", "?"),
                                    p.get("wentylator_rpm", "?"), p.get("waty", "?"),
                                    p.get("bateria_pct", "?"),
                                    "zasilacz" if p.get("na_zasilaczu") == "1" else "bateria",
                                    p.get("load1", "?")))
    except FileNotFoundError:
        pass
    if not zdarzen:
        W.append("  (brak — w tym okresie nie wykryto twardego wylaczenia ani alarmu chlodzenia)")

    W.append("\n## POWODY WYLACZEN WG SYSTEMU\n")
    wy = sh(["pmset", "-g", "log"], timeout=60)
    trafienia = [l for l in wy.splitlines() if "shutdown cause" in l.lower()][-10:]
    W.extend("  " + l.strip() for l in trafienia) if trafienia else W.append(
        "  (brak wpisow 'Previous shutdown cause' — typowe przy utracie zasilania)")

    W.append("\n## INTERWENCJE BEZPIECZNIKA\n")
    inter = 0
    try:
        with open(LOG) as f:
            for linia in f:
                if czas_z(linia[:19]) < granica:
                    continue
                if re.search(r"PAUZA|WZNOWIONE|SIGTERM|koncze zadanie|AWARIA|TWARDY", linia):
                    inter += 1
                    W.append("  " + linia.rstrip())
    except FileNotFoundError:
        pass
    if not inter:
        W.append("  (brak)")

    W.append("\n## OS CZASU POMIAROW\n")
    W.append("  czas, chip C, GPU C, bateria C, obroty, W, bateria %, zasilacz, CPU limit, load, poziom")
    ile = 0
    szczyt = (0, "")
    try:
        with open(HIST) as f:
            naglowek = f.readline()
            for linia in f:
                c = linia.strip().split(",")
                if len(c) < 12 or czas_z(c[0]) < granica:
                    continue
                ile += 1
                try:
                    if c[2] and float(c[2]) > szczyt[0]:
                        szczyt = (float(c[2]), c[0])
                except ValueError:
                    pass
                W.append("  " + ", ".join(c[:12]))
    except FileNotFoundError:
        pass
    if szczyt[0]:
        W.insert(len(W) - ile - 2, "  NAJWYZSZA ZMIERZONA TEMPERATURA CHIPA: %.1f C (%s)" % szczyt)

    W.append("\n" + "=" * 78)
    W.append("Pomiary zbiera thermal-guard co 15 s (zapis co 5 min oraz przy kazdym zdarzeniu).")
    W.append("Temperatura chipa czytana przez IOReport, temperatura baterii przez AppleSmartBattery.")

    tekst = "\n".join(W) + "\n"
    with open(cel, "w") as f:
        f.write(tekst)
    print(cel)
    return 0


if __name__ == "__main__":
    sys.exit(main())
