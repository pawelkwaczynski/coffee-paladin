<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>pl.pawel.heatbar</string>
  <key>ProgramArguments</key>
  <array><string>__HOME__/.local/bin/heatbar</string></array>
  <key>RunAtLoad</key><true/>
  <!-- Wskrzeszamy TYLKO po awarii. Z KeepAlive=true "Zakoncz heatbar" z menu bylo bezuzyteczne:
       launchd natychmiast startowal go z powrotem. SuccessfulExit=false = restartuj, gdy proces
       wyszedl z bledem; czyste wyjscie uzytkownika zostaje respektowane. -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardErrorPath</key><string>__HOME__/.thermal-guard/heatbar.err</string>
</dict>
</plist>
