DICTS = {"pl": PL, "ru": RU, "zh": ZH, "es": ES}


def T(s):
    return DICTS.get(LANG, {}).get(s, s)


def fleet_dir_from_config():
    try:
        with open(os.path.join(BASE, "config.json")) as f:
            return os.path.expanduser(json.load(f).get("fleet_dir") or "")
    except Exception:
        return ""


def age_str(seconds):
    if seconds < 90:
        return T("now")
    if seconds < 5400:
        return T("%d min ago") % round(seconds / 60)
    return T("%d h ago") % round(seconds / 3600)


def _num(v):
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def _czysty_tekst(s, limit=60):
    """Tekst z obcej migawki bez znakow sterujacych i bez przesady w dlugosci.

    Migawki leza we wspoldzielonym folderze (iCloud, SMB, SharePoint), wiec kazdy,
    kto ma tam zapis, moze wstawic np. "\x1b[2J" - sekwencje czyszczaca ekran w srodku
    tabeli, ktora skasuje juz wypisane wiersze razem z ostrzezeniem o awarii.
    """
    return "".join(c for c in str(s) if c.isprintable())[:limit]


def load_hosts(d):
    """Wczytuje migawki, NORMALIZUJAC typy: zepsuty/reczny plik jednego hosta nie moze
    wywalic tabeli calej floty (liczby jako stringi, level spoza 0-3 itd.)."""
    hosts = []
    for name in sorted(os.listdir(d)):
        if name.endswith(".json.icloud"):
            # zewinkowane przez iCloud: host istnieje, danych nie ma pod reka
            base = name.lstrip(".")[:-len(".json.icloud")]
            hosts.append({"host": base, "_age": 1e9})
            continue
        if not name.endswith(".json") or name.startswith("."):
            continue
        path = os.path.join(d, name)
        try:
            with open(path) as f:
                snap = json.load(f)
            if not isinstance(snap, dict):
                continue
        except Exception:
            # Zepsuty plik NIE moze znikac po cichu: host wypadal z tabeli, a operator
            # widzial "all machines look fine". Zostaje w tabeli, oznaczony i policzony.
            hosts.append({"host": name[:-5][:18], "_age": time.time() - os.path.getmtime(path),
                          "_bad": True, "level": 0, "fans": []})
            continue
        for k in ("chip_c", "watts", "ram_used_gb", "ram_total_gb"):
            snap[k] = _num(snap.get(k))
        for k in ("disk_used_pct", "battery_pct", "cpu_limit"):
            v = _num(snap.get(k))
            snap[k] = int(v) if v is not None else None
        lv = _num(snap.get("level"))
        snap["level"] = min(max(int(lv), 0), 3) if lv is not None else 0
        fans = snap.get("fans")
        snap["fans"] = [int(f) for f in fans if _num(f) is not None] if isinstance(fans, list) else []
        # Pola, ktore ida prosto do renderu. Migawka pochodzi ze WSPOLDZIELONEGO
        # folderu, wiec traktujemy ja jak dane z obcej maszyny: kazdy typ moze byc inny,
        # a znaki sterujace ANSI w nazwie hosta potrafia skasowac juz wypisane wiersze.
        for k in ("host", "model"):
            v = snap.get(k)
            snap[k] = _czysty_tekst(v) if isinstance(v, str) else (None if v is None else _czysty_tekst(str(v)))
        p = snap.get("paused")
        snap["paused"] = [_czysty_tekst(str(x))[:24] for x in p][:6] if isinstance(p, list) else []
        if not isinstance(snap.get("stats"), dict):
            snap["stats"] = {}
        if not isinstance(snap.get("last_hard_shutdown"), dict):
            snap["last_hard_shutdown"] = None
        if not isinstance(snap.get("on_ac"), bool):
            v = snap.get("on_ac")
            snap["on_ac"] = True if v is None else str(v).strip().lower() in ("1", "true", "yes", "tak")
        wiek = time.time() - os.path.getmtime(path)
        snap["_age"] = max(wiek, 0.0)   # zegar drugiej maszyny bywa w przyszlosci
        snap.setdefault("host", name[:-5])
        hosts.append(snap)
    return hosts


def issues_for(h):
    """Problemy hosta, w kolejnosci powagi. Pusta lista = wszystko dobrze."""
    out = []
    # nie raportuje > 5 min: albo padl, albo spi, albo folder sie nie synchronizuje
    if h["_age"] > 300:
        out.append(T("STALE - not reporting"))
        return out
    crash = h.get("last_hard_shutdown") or {}
    if crash.get("time"):
        out.append(T("hard shutdown %s") % crash["time"])
    if h.get("cpu_limit") is not None and h["cpu_limit"] < 100:
        out.append(T("throttled to %d%%") % h["cpu_limit"])
    fans = h.get("fans") or []
    chip = h.get("chip_c")
    if fans and chip and max(fans) == 0 and chip >= 70:
        out.append(T("fans dead at %.0f C") % chip)
    if not h.get("on_ac", True) and h.get("battery_pct") is not None and h["battery_pct"] <= 20:
        out.append(T("battery %d%% unplugged") % h["battery_pct"])
    if (h.get("disk_used_pct") or 0) >= 92:
        out.append(T("disk %d%% full") % h["disk_used_pct"])
    if h.get("paused"):
        out.append(T("paused: %s") % ",".join(h["paused"])[:30])
    return out


def render(d):
    hosts = load_hosts(d)
    if not hosts:
        print(T("no agent snapshots in %s (agents publish about once a minute)") % d)
        return 1

    print(T("FLEET: %d machine(s), folder %s") % (len(hosts), d))
    print()
    hdr = (T("HOST"), "MODEL", T("CHIP"), T("FAN"), T("POWER"), T("RAM"), T("DISK"),
           T("STATE"), T("TODAY"), T("SEEN"), T("ISSUES"))
    rows = []
    attention = []
    levels = [T("calm"), T("warm"), T("HOT"), T("CRIT")]
    for h in hosts:
        probs = issues_for(h)
        stale = h["_age"] > 300
        fans = h.get("fans") or []
        stats = h.get("stats") or {}
        today = "%dp" % stats.get("pauses", 0)
        if stats.get("kills"):
            today += " %dk" % stats["kills"]
        rows.append((
            h["host"][:18],
            (h.get("model") or "-")[:22],
            "-" if stale or h.get("chip_c") is None else "%.0fC" % h["chip_c"],
            "-" if stale or not fans else ("0!" if max(fans) == 0 and (h.get("chip_c") or 0) >= 70
                                          else "%.1fk" % (max(fans) / 1000.0) if max(fans) >= 1000
                                          else str(max(fans))),
            "-" if stale or h.get("watts") is None else "%.0fW" % h["watts"],
            "-" if stale or not h.get("ram_total_gb") else "%d%%" % round(
                100.0 * h.get("ram_used_gb", 0) / h["ram_total_gb"]),
            "-" if stale or h.get("disk_used_pct") is None else "%d%%" % h["disk_used_pct"],
            "?" if stale else levels[h.get("level", 0)],
            "-" if stale else today,
            age_str(h["_age"]),
            "; ".join(probs),
        ))
        if probs:
            attention.append((h["host"], probs))

    widths = [max(len(str(r[i])) for r in rows + [hdr]) for i in range(len(hdr))]
    fmt = "  ".join("%%-%ds" % w for w in widths)
    print(fmt % hdr)
    print(fmt % tuple("-" * w for w in widths))
    for r in rows:
        print(fmt % r)
    print()
    if attention:
        print(T("%d machine(s) need attention:") % len(attention))
        for host, probs in attention:
            print("  %s: %s" % (host, "; ".join(probs)))
        return 2
    print(T("all machines look fine"))
    return 0


def candidates():
    """Foldery synchronizowane obecne na TEJ maszynie — nic nie zgadujemy, tylko pokazujemy,
    co uzytkownik juz ma. Wybor nalezy do niego (iCloud dla jednej osoby, Dropbox/Drive dla
    zespolu, OneDrive/SharePoint w firmie, wolumen SMB na farmie)."""
    H = os.path.expanduser("~")
    out = []
    ic = os.path.join(H, "Library/Mobile Documents/com~apple~CloudDocs")
    if os.path.isdir(ic):
        out.append(("iCloud Drive", os.path.join(ic, "FleetTG")))
    cs = os.path.join(H, "Library/CloudStorage")
    if os.path.isdir(cs):
        for name in sorted(os.listdir(cs)):
            full = os.path.join(cs, name)
            # tylko realne foldery dostawcow (OneDrive-..., GoogleDrive-..., Dropbox),
            # bez plikow ukrytych w rodzaju .DS_Store
            if name.startswith(".") or not os.path.isdir(full):
                continue
            out.append((name.replace("-", " "), os.path.join(full, "FleetTG")))
    for d, label in (("Dropbox", "Dropbox"), ("Google Drive", "Google Drive")):
        if os.path.isdir(os.path.join(H, d)):
            out.append((label, os.path.join(H, d, "FleetTG")))
    try:
        for v in sorted(os.listdir("/Volumes")):
            pth = os.path.join("/Volumes", v)
            if os.path.ismount(pth) and os.access(pth, os.W_OK) and v != "Macintosh HD":
                out.append(("Network/external volume: %s" % v, os.path.join(pth, "FleetTG")))
    except Exception:
        pass
    return out


def set_dir(path):
    path = os.path.expanduser(path)
    try:
        os.makedirs(path, exist_ok=True)
    except Exception:
        pass
    cfgp = os.path.join(BASE, "config.json")
    os.makedirs(BASE, exist_ok=True)
    # Config, ktorego nie umiemy sparsowac, jest NIETYKALNY. Nadpisanie go wlasnym
    # kluczem kasowaloby progi i dry_run:false, czyli po cichu wylaczaloby ochrone -
    # a komunikat nizej mowilby "zapisane". Lepiej odmowic i pokazac plik.
    c = {}
    if os.path.exists(cfgp):
        try:
            with open(cfgp) as f:
                c = json.load(f)
            if not isinstance(c, dict):
                raise ValueError("config.json nie jest obiektem")
        except Exception as e:
            print(T("fleet: cannot read %s (%s) - not touching it. Fix the file first.")
                  % (cfgp, e), file=sys.stderr)
            return 1
    c["fleet_dir"] = path
    # flock na tym samym pliku, ktorego uzywaja guard i pasek menu
    import fcntl
    lock = open(os.path.join(BASE, "config.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        tmp = cfgp + ".tmp"
        with open(tmp, "w") as f:
            json.dump(c, f, indent=2, ensure_ascii=False)
        os.replace(tmp, cfgp)
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()
    print(T("fleet_dir saved: %s (the agent starts publishing within a minute)") % path)
    return 0


def setup():
    cand = candidates()
    if not cand:
        print(T("no synced folders detected - pass the path yourself: fleet --set-dir <folder>"))
        return 1
    print(T("Detected folders every machine of yours could share:"))
    for i, (label, path) in enumerate(cand, 1):
        print("  %d) %-28s %s" % (i, label, path))
    print(T("Pick a number (the SAME folder must be set on every machine):"))
    try:
        n = int(input("> ").strip())
        label, path = cand[n - 1]
    except Exception:
        print(T("cancelled"))
        return 1
    return set_dir(path)


def main():
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__)
        return 0
    if "--set-dir" in sys.argv:
        return set_dir(sys.argv[sys.argv.index("--set-dir") + 1])
    if "--setup" in sys.argv:
        return setup()
    d = ""
    if "--dir" in sys.argv:
        d = os.path.expanduser(sys.argv[sys.argv.index("--dir") + 1])
    else:
        d = fleet_dir_from_config()
    if not d or not os.path.isdir(d):
        print(T("no fleet folder - set \"fleet_dir\" in ~/.coffee-paladin/config.json or pass --dir"))
        return 1

    if "--json" in sys.argv:
        hosts = load_hosts(d)
        for h in hosts:
            h["issues"] = issues_for(h)
            h["age_seconds"] = round(h.pop("_age"))
        print(json.dumps({"folder": d, "hosts": hosts}, ensure_ascii=False, indent=2))
        # README obiecuje: "fleet --json plus the exit code plug into cron, Grafana or
        # Slack". Bez tego --json zawsze zwracalo 0 i alarm w cronie nigdy nie strzelal.
        return 2 if any(h["issues"] for h in hosts) else 0

    if "--watch" in sys.argv:
        while True:
            os.system("clear")
            render(d)
            time.sleep(30)
    return render(d)


if __name__ == "__main__":
    sys.exit(main())
