def age_str(seconds):
    if seconds < 90:
        return T("now")
    if seconds < 5400:
        return T("%d min ago") % round(seconds / 60)
    return T("%d h ago") % round(seconds / 3600)


def _num(v):
    """Return a number or None. OverflowError and NaN also mean "no data".

    Snapshots arrive from a shared folder, so one may contain a 400-digit int
    (float() raises OverflowError) or "nan" (float() accepts it, int() does not).
    """
    try:
        f = float(v)
    except (TypeError, ValueError, OverflowError):
        return None
    return None if f != f or f in (float("inf"), float("-inf")) else f


def _numbers(v):
    """Lista intow z czegokolwiek. `_num` przepuszcza stringi ("3.5"), a int() na nich pada."""
    if not isinstance(v, list):
        return []
    out = []
    for x in v:
        n = _num(x)
        if n is None or n != n:
            continue
        try:
            out.append(int(n))
        except (ValueError, OverflowError):
            continue
    return out


def _clean_text(s, limit=60):
    """Text from a foreign snapshot: no control characters, sane length.

    Snapshots live in a shared folder (iCloud, SMB, SharePoint), so anyone
    with write access there can plant e.g. "\x1b[2J" - a clear-screen
    sequence in the middle of the table that would erase rows already
    printed, including a failure warning.
    """
    return "".join(c for c in str(s) if c.isprintable())[:limit]


def _snapshot_age(snap, path):
    """Age of a host report, computed from snapshot CONTENT, not file metadata.

    iCloud can keep an mtime many days old on perfectly fresh content: a
    healthy Mac reporting every minute once hung in the table as "STALE - not
    reporting (94 h)". The truth is inside the file: `epoch` (written by the
    guard since 2.3.4), older daemons provide a `time` string with a UTC
    offset. mtime remains a last resort for snapshots predating the offset
    format - a naive local time of a foreign machine must never be
    interpreted in our own timezone."""
    e = _num(snap.get("epoch"))
    if e is not None and 0 < e < 4e9:
        return time.time() - e
    t = snap.get("time")
    if isinstance(t, str):
        try:
            dt = datetime.datetime.strptime(t.strip(), "%Y-%m-%d %H:%M:%S%z")
            return time.time() - dt.timestamp()
        except ValueError:
            pass
    try:
        return time.time() - os.path.getmtime(path)
    except OSError:
        return 1e9


def load_hosts(d):
    """Load snapshots, NORMALIZING types: one broken or hand-edited host file
    must not take down the whole fleet table (numbers as strings, level
    outside 0-3, and so on)."""
    hosts = []
    for name in sorted(os.listdir(d)):
        if name.endswith(".json.icloud"):
            # evicted by iCloud: the host exists, its data is not at hand
            base = _clean_text(name.lstrip(".")[:-len(".json.icloud")], 18)
            hosts.append({"host": base, "_age": 1e9})
            continue
        if not name.endswith(".json") or name.startswith("."):
            continue
        path = os.path.join(d, name)
        # The fleet folder is EXTERNAL INPUT: iCloud, SMB, other people's Macs.
        # Anything here can be half-synced, deleted between listdir and open,
        # or not a file at all. Hence stat first, then read, and every error
        # ends as an ENTRY, not as a host vanishing from the table.
        #   - `os.path.getmtime` in the error path used to raise itself when
        #     the file was already gone, taking down the WHOLE table including
        #     healthy machines;
        #   - a named pipe or a link to /dev/zero hung `fleet` forever;
        #   - JSON that is a list (not an object) silently dropped the host
        #     via `continue`.
        try:
            st = os.lstat(path)
            if not stat.S_ISREG(st.st_mode):
                raise ValueError("not a regular file")
            if st.st_size > 256 * 1024:
                raise ValueError("snapshot too large: %d B" % st.st_size)
            with open(path, encoding="utf-8", errors="replace") as f:
                snap = json.load(f)
            if not isinstance(snap, dict):
                raise ValueError("JSON is not an object")
        except Exception:
            # A broken file must NOT vanish silently: the host used to drop out
            # of the table and the operator saw "all machines look fine". It
            # stays in the table, flagged and counted.
            try:
                age = time.time() - os.lstat(path).st_mtime
            except OSError:
                age = 1e9
            hosts.append({"host": _clean_text(name[:-5], 18), "_age": age,
                          "_bad": True, "level": 0, "fans": []})
            continue
        # Implausibility must be noticed BEFORE normalization: `_num()` turns
        # inf and NaN into None, after which "sensor did not answer" is
        # indistinguishable from "snapshot is nonsense". A host full of
        # infinities used to show up as a calm, healthy machine.
        _suspicious = []
        for k in ("chip_c", "battery_c", "gpu_c", "level", "load1", "watts", "battery_pct"):
            v = snap.get(k)
            if v is None or isinstance(v, str):
                continue
            if isinstance(v, bool) or not isinstance(v, (int, float)) or v != v \
                    or abs(v) == float("inf"):
                _suspicious.append(k)
        if _suspicious:
            snap["_implausible"] = sorted(_suspicious)
        for k in ("chip_c", "watts", "ram_used_gb", "ram_total_gb"):
            snap[k] = _num(snap.get(k))
        if snap["ram_used_gb"] is None or snap["ram_total_gb"] is None:
            snap["ram_used_gb"] = snap["ram_total_gb"] = None   # one without the other = no data
        for k in ("disk_used_pct", "battery_pct", "cpu_limit"):
            v = _num(snap.get(k))
            snap[k] = int(v) if v is not None else None
        lv = _num(snap.get("level"))
        try:
            snap["level"] = min(max(int(lv), 0), 3) if lv is not None else 0
        except (ValueError, OverflowError):
            snap["level"] = 0              # "nan", 1e400: _num passes them, int() does not
        fans = snap.get("fans")
        snap["fans"] = _numbers(fans)
        # Fields that go straight to the render. The snapshot comes from a
        # SHARED folder, so treat it as data from a foreign machine: every type
        # can differ, and ANSI control characters in a host name can erase
        # rows already printed.
        for k in ("host", "model"):
            v = snap.get(k)
            if v is None or (isinstance(v, str) and not v.strip()):
                snap.pop(k, None)          # None must not stay: it blocked setdefault below
            else:
                snap[k] = _clean_text(v if isinstance(v, str) else str(v))
        p = snap.get("paused")
        snap["paused"] = [_clean_text(str(x))[:24] for x in p][:6] if isinstance(p, list) else []
        st = snap.get("stats")
        # Checking "is it a dict" is not enough: %d on a value like "lots"
        # kills the render. `v == v` filtered NaN but let infinity through,
        # and JSON `1e400` parses in Python to exactly inf; `int(inf)` raises
        # OverflowError, which used to take down the WHOLE table. `_num`
        # checks both.
        snap["stats"] = {k: int(_num(v)) for k, v in st.items()
                         if _num(v) is not None} if isinstance(st, dict) else {}
        crash = snap.get("last_hard_shutdown")
        if isinstance(crash, dict):
            # this field also reaches the operator's terminal - it must be sanitized
            snap["last_hard_shutdown"] = {"time": _clean_text(crash.get("time", ""), 30)}
        else:
            snap["last_hard_shutdown"] = None
        if not isinstance(snap.get("on_ac"), bool):
            v = snap.get("on_ac")
            snap["on_ac"] = True if v is None else str(v).strip().lower() in ("1", "true", "yes", "tak")
        snap["_age"] = max(_snapshot_age(snap, path), 0.0)   # another machine's clock can run ahead
        snap.setdefault("host", _clean_text(name[:-5], 18))
        hosts.append(snap)
    return hosts


def issues_for(h):
    """Host problems, most serious first. Empty list = all good."""
    out = []
    # Unreadable snapshot: the host used to report as "calm and reporting now"
    # because the _bad flag was SET but never read. A machine we know nothing
    # about must never be described as fine.
    if h.get("_bad"):
        out.append(T("unreadable snapshot"))
        return out
    # Not reporting > 5 min: crashed, asleep, or the folder is not syncing.
    # There used to be a `return out` here, so "not reporting" CUT OFF all
    # remaining problems. Effect: a Mac that crashed hard at 98.7 C and never
    # came back showed only "not reporting" in ISSUES - the most important
    # information in the whole fleet hidden behind the least important. A
    # non-reporting machine is exactly the one you need to know MOST about.
    stale = h["_age"] > 300
    if stale:
        out.append(T("STALE - not reporting"))
    # Level 2 = the guard is pausing, 3 = critical. A machine with the chip
    # near 100 C used to fall off the "needs attention" list and
    # `fleet --json` exited zero, so cron and Grafana stayed silent exactly
    # when they should have screamed. A snapshot full of inf/NaN reported as
    # a HEALTHY machine: `float("nan") >= 2` is False and `or 0` does not
    # catch NaN, so a host with chip_c=inf and level=NaN rendered as "calm".
    # Nonsense readings must never read as calm - same bug as "unreadable".
    if h.get("_implausible"):
        out.append(T("implausible readings: %s") % ",".join(h["_implausible"])[:40])

    level = h.get("level") or 0
    if isinstance(level, (int, float)) and level >= 2:
        chip = h.get("chip_c")
        out.append(T("HOT - %.0f C") % chip if isinstance(chip, (int, float))
                   else T("HOT - guard is intervening"))
    crash = h.get("last_hard_shutdown") or {}
    if crash.get("time"):
        out.append(T("hard shutdown %s") % crash["time"])
    if h.get("cpu_limit") is not None and h["cpu_limit"] < 100:
        out.append(T("throttled to %d%%") % h["cpu_limit"])
    fans = h.get("fans") or []
    chip = h.get("chip_c")
    if fans and chip and max(fans) == 0 and chip >= 70:
        out.append(T("fans dead at %.0f C") % chip)
    if not h.get("on_ac", True) and h.get("battery_pct") is not None and h["battery_pct"] <= 20:
        out.append(T("battery %d%% unplugged") % h["battery_pct"])
    if h.get("chip_sensor") is False:
        out.append(T("no chip sensor - battery temperature only"))
    if (h.get("disk_used_pct") or 0) >= 92:
        out.append(T("disk %d%% full") % h["disk_used_pct"])
    if h.get("paused"):
        out.append(T("paused: %s") % ",".join(h["paused"])[:30])
    return out


def render(d):
    hosts = load_hosts(d)
    if not hosts:
        print(T("no agent snapshots in %s (agents publish about once a minute)") % d)
        return 1

    print(T("FLEET: %d machine(s), folder %s") % (len(hosts), d))
    print()
    hdr = (T("HOST"), "MODEL", T("CHIP"), T("FAN"), T("POWER"), T("RAM"), T("DISK"),
           T("STATE"), T("TODAY"), T("SEEN"), T("ISSUES"))
    rows = []
    attention = []
    levels = [T("calm"), T("warm"), T("HOT"), T("CRIT")]
    for h in hosts:
        probs = issues_for(h)
        stale = h["_age"] > 300
        fans = h.get("fans") or []
        stats = h.get("stats") or {}
        today = "%dp" % stats.get("pauses", 0)
        if stats.get("kills"):
            today += " %dk" % stats["kills"]
        rows.append((
            h["host"][:18],
            (h.get("model") or "-")[:22],
            "-" if stale or h.get("chip_c") is None else "%.0fC" % h["chip_c"],
            "-" if stale or not fans else ("0!" if max(fans) == 0 and (h.get("chip_c") or 0) >= 70
                                          else "%.1fk" % (max(fans) / 1000.0) if max(fans) >= 1000
                                          else str(max(fans))),
            "-" if stale or h.get("watts") is None else "%.0fW" % h["watts"],
            "-" if stale or not h.get("ram_total_gb") else "%d%%" % round(
                # the quotient needs checking too: finite operands, non-finite result
                min(max(_num(100.0 * h.get("ram_used_gb", 0) / h["ram_total_gb"]) or 0, 0), 999)),
            "-" if stale or h.get("disk_used_pct") is None else "%d%%" % h["disk_used_pct"],
            "?" if stale else levels[h.get("level", 0)],
            "-" if stale else today,
            age_str(h["_age"]),
            "; ".join(probs),
        ))
        if probs:
            attention.append((h["host"], probs))

    widths = [max(len(str(r[i])) for r in rows + [hdr]) for i in range(len(hdr))]
    fmt = "  ".join("%%-%ds" % w for w in widths)
    print(fmt % hdr)
    print(fmt % tuple("-" * w for w in widths))
    for r in rows:
        print(fmt % r)
    print()
    if attention:
        print(T("%d machine(s) need attention:") % len(attention))
        for host, probs in attention:
            print("  %s: %s" % (host, "; ".join(probs)))
        return 2
    print(T("all machines look fine"))
    return 0


def candidates():
    """Synced folders present on THIS machine - nothing is guessed, we only
    show what the user already has. The choice is theirs (iCloud for one
    person, Dropbox/Drive for a team, OneDrive/SharePoint in a company, an
    SMB volume on a farm)."""
    H = os.path.expanduser("~")
    out = []
    ic = os.path.join(H, "Library/Mobile Documents/com~apple~CloudDocs")
    if os.path.isdir(ic):
        out.append(("iCloud Drive", os.path.join(ic, "FleetTG")))
    cs = os.path.join(H, "Library/CloudStorage")
    if os.path.isdir(cs):
        for name in sorted(os.listdir(cs)):
            full = os.path.join(cs, name)
            # only real provider folders (OneDrive-..., GoogleDrive-..., Dropbox),
            # not hidden files like .DS_Store
            if name.startswith(".") or not os.path.isdir(full):
                continue
            out.append((name.replace("-", " "), os.path.join(full, "FleetTG")))
    for d, label in (("Dropbox", "Dropbox"), ("Google Drive", "Google Drive")):
        if os.path.isdir(os.path.join(H, d)):
            out.append((label, os.path.join(H, d, "FleetTG")))
    try:
        for v in sorted(os.listdir("/Volumes")):
            pth = os.path.join("/Volumes", v)
            if os.path.ismount(pth) and os.access(pth, os.W_OK) and v != "Macintosh HD":
                out.append(("Network/external volume: %s" % v, os.path.join(pth, "FleetTG")))
    except Exception:
        pass
    return out


def set_dir(path):
    path = os.path.expanduser(path)
    try:
        os.makedirs(path, exist_ok=True)
    except Exception:
        pass
    cfgp = os.path.join(BASE, "config.json")
    os.makedirs(BASE, 0o700, exist_ok=True)
    # A config we cannot parse is UNTOUCHABLE. Overwriting it with our own key
    # would erase thresholds and dry_run:false, silently disarming protection,
    # while the message below would say "saved". Refuse and show the file.
    c = {}
    if os.path.exists(cfgp):
        try:
            with open(cfgp) as f:
                c = json.load(f)
            if not isinstance(c, dict):
                raise ValueError("config.json is not an object")
        except Exception as e:
            print(T("fleet: cannot read %s (%s) - not touching it. Fix the file first.")
                  % (cfgp, e), file=sys.stderr)
            return 1
    c["fleet_dir"] = path
    # flock on the same file the guard and the menu bar use
    import fcntl
    # 0600, not umask. config.json holds `ntfy_topic`, which is the ONLY
    # protection for notifications: whoever knows the topic reads other
    # people's alerts and can impersonate them. `ensure_dirs()` in the daemon
    # tightens permissions only at startup, so a later `fleet --setup` used to
    # expose the file until the next restart.
    lock_fd = os.open(os.path.join(BASE, "config.lock"), os.O_WRONLY | os.O_CREAT, 0o600)
    lock = os.fdopen(lock_fd, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        tmp = cfgp + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(c, f, indent=2, ensure_ascii=False)
        os.replace(tmp, cfgp)
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()
    print(T("fleet_dir saved: %s (the agent starts publishing within a minute)") % path)
    return 0


def setup():
    cand = candidates()
    if not cand:
        print(T("no synced folders detected - pass the path yourself: fleet --set-dir <folder>"))
        return 1
    print(T("Detected folders every machine of yours could share:"))
    for i, (label, path) in enumerate(cand, 1):
        print("  %d) %-28s %s" % (i, label, path))
    print(T("Pick a number (the SAME folder must be set on every machine):"))
    try:
        n = int(input("> ").strip())
        label, path = cand[n - 1]
    except Exception:
        print(T("cancelled"))
        return 1
    return set_dir(path)


def main():
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__)
        return 0
    if "--set-dir" in sys.argv:
        try:
            _v = sys.argv[sys.argv.index("--set-dir") + 1]
        except IndexError:
            print(T("fleet: --set-dir needs a folder path"), file=sys.stderr)
            return 2
        return set_dir(_v)
    if "--setup" in sys.argv:
        return setup()
    d = ""
    if "--dir" in sys.argv:
        try:
            d = os.path.expanduser(sys.argv[sys.argv.index("--dir") + 1])
        except IndexError:
            print(T("fleet: --dir needs a folder path"), file=sys.stderr)
            return 2
    else:
        d = fleet_dir_from_config()
    if not d or not os.path.isdir(d):
        print(T("no fleet folder - set \"fleet_dir\" in ~/.coffee-paladin/config.json or pass --dir"))
        return 1

    if "--json" in sys.argv:
        hosts = load_hosts(d)
        for h in hosts:
            h["issues"] = issues_for(h)
            h["age_seconds"] = round(h.pop("_age"))
        print(json.dumps({"folder": d, "hosts": hosts}, ensure_ascii=False, indent=2))
        # The README promises: "fleet --json plus the exit code plug into cron,
        # Grafana or Slack". Without this, --json always returned 0 and a cron
        # alarm never fired.
        return 2 if any(h["issues"] for h in hosts) else 0

    if "--watch" in sys.argv:
        while True:
            # ANSI sequence instead of os.system("clear"): no shell, no $TERM
            # dependency (in cron and over ssh, clear printed an error every
            # cycle) and no 2880 shells spawned per day.
            sys.stdout.write("\033[H\033[2J")
            render(d)
            time.sleep(30)
    return render(d)


if __name__ == "__main__":
    sys.exit(main())
