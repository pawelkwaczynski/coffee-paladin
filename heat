        print(T("   fans: %s%s") % (opis, ostrz))

    if snap:
        zas = T("AC adapter") if snap.get("on_ac") else T("battery %s%%") % snap.get("battery_pct", "?")
        watts = _num(snap.get("watts"))
        print(T("   power: %s%s") % (zas, (T("   draw: %.1f W") % watts) if watts else ""))

    if lifetime:
        print(T("   battery temperature record (whole lifetime): %.1f °C") % lifetime)

    running = AGENT in sh(["launchctl", "list"]) or bool(sh(["pgrep", "-f", "guard.py"]).strip())
    print(T("   coffee-paladin: %s") % (T("running ✅") if running else T("NOT RUNNING ❌  (launchctl kickstart -k gui/%d/%s)") % (os.getuid(), AGENT)))

    try:
        with open(STATE) as f:
            st = json.load(f)
        if st.get("paused"):
            for k, v in st["paused"].items():
                print(T("   ⏸  paused: %s (pid %s, since %s)")
                      % (v.get("comm"), k, time.strftime("%H:%M", time.localtime(v.get("since", 0)))))
    except Exception:
        pass

    print(T("\nTop CPU right now:"))
    out = sh(["ps", "-Ao", "pid=,pcpu=,comm=", "-c", "-r"])
    for line in out.splitlines()[:6]:
        p = line.split(None, 2)
        if len(p) == 3:
            print("   %-22s pid %-7s %5s%%" % (p[2][:22], p[0], p[1]))

    # maks. z ostatnich 24 h z historii guarda
    try:
        cutoff = time.time() - 86400
        best, when = None, None
        with open(HIST) as f:
            next(f, None)
            for line in f:
                c = line.split(",")
                if len(c) < 3 or not c[2]:
                    continue
                try:
                    t = time.mktime(time.strptime(c[0], "%Y-%m-%d %H:%M:%S"))
                except Exception:
                    continue
                if t >= cutoff:
                    v = float(c[2])
                    if best is None or v > best:
                        best, when = v, c[0]
        if best:  # kolumna 2 to teraz temperatura CHIPA (wczesniej byla bateria)
            print(T("\nPeak chip temperature in the last 24 h: %.1f °C (%s)") % (best, when))
    except Exception:
        pass

    try:
        with open(LOG) as f:
            lines = [l.rstrip() for l in f if any(k in l for k in (
                "[PAUSE]", "[RESUME]", "[KILL]", "[DEMOTE]", "[PROMOTE]", "[FANFAIL]",
                "PAUSED", "RESUMED", "PAUZA", "WZNOWIONE", "TERMINATED", "SIGKILL", "DEMOT"))]
        if lines:
            print(T("\nRecent guard interventions:"))
            for l in lines[-5:]:
                print("   " + l)
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
