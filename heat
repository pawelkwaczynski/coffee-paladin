def _kolorowy_terminal():
    """Truecolor: nowoczesne terminale (ghostty, iTerm2, kitty, WezTerm, VS Code).
    Bez tty, przy NO_COLOR albo przy --ascii wracamy do wersji znakowej - potok do pliku
    ma zostac czytelny, a Terminal.app (bez truecolor) ma dostac cos, co wyglada jak rycerz."""
    if "--ascii" in sys.argv:
        return False
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("COLORTERM", "") in ("truecolor", "24bit"):
        return True
    return os.environ.get("TERM", "").endswith(("256color", "kitty", "ghostty"))


