# Grafika w terminalu: wysokosc w wierszach. 26 to polowa rysunku z polblokow,
# a mimo to jest ostra - bo to prawdziwe piksele, nie znaki.
OBRAZ_WIERSZY = 26


def _protokol_obrazkowy():
    """Czy terminal umie wyswietlic PRAWDZIWY obrazek (nie znaki)?

    Zwraca "kitty" (Ghostty, kitty, WezTerm), "iterm" (iTerm2) albo None.
    To jest jedyny sposob, zeby rysunek byl JEDNOCZESNIE maly i ostry: polbloki
    maja rozdzielczosc siatki znakow, obrazek ma rozdzielczosc ekranu.
    """
    if not sys.stdout.isatty() or "--ascii" in sys.argv or "--bloki" in sys.argv:
        return None
    if os.environ.get("TG_NO_IMAGE"):
        return None
    # tmux i screen nie przepuszczaja protokolu graficznego - zamiast obrazka
    # uzytkownik dostalby na ekran kilkaset kilobajtow base64. Lepiej polbloki.
    if os.environ.get("TMUX") or os.environ.get("TERM", "").startswith(("screen", "tmux")):
        return None
    term = os.environ.get("TERM", "")
    prog = os.environ.get("TERM_PROGRAM", "")
    if "kitty" in term or "ghostty" in term or prog in ("ghostty", "WezTerm"):
        return "kitty"
    if prog == "iTerm.app":
        return "iterm"
    return None


def _wyslij_obraz(sciezka, protokol, wierszy=OBRAZ_WIERSZY):
    """Wypycha PNG do terminala. Zwraca True, gdy sie udalo."""
    import base64
    try:
        with open(sciezka, "rb") as f:
            dane = base64.b64encode(f.read())
    except Exception:
        return False
    out = sys.stdout
    if protokol == "iterm":
        out.write("\033]1337;File=inline=1;height=%d;preserveAspectRatio=1:%s\a\n"
                  % (wierszy, dane.decode("ascii")))
        out.flush()
        return True

    # Protokol kitty: dane ida porcjami po 4096 znakow base64; m=1 znaczy
    # "bedzie ciag dalszy", ostatnia porcja ma m=0. C=1 zabrania terminalowi
    # ruszac kursorem, wiec sami przewijamy o dokladnie tyle wierszy, ile zajal
    # obrazek - inaczej tekst pod spodem wladowalby sie na rycerza.
    KROK = 4096
    porcje = [dane[i:i + KROK] for i in range(0, len(dane), KROK)] or [b""]
    for nr, porcja in enumerate(porcje):
        if nr == 0:
            naglowek = "a=T,f=100,t=d,r=%d,C=1,m=%d" % (wierszy, 1 if len(porcje) > 1 else 0)
        else:
            naglowek = "m=%d" % (1 if nr < len(porcje) - 1 else 0)
        out.write("\033_G%s;%s\033\\" % (naglowek, porcja.decode("ascii")))
    out.write("\n" * wierszy)
    out.flush()
    return True


def paladin(ile_stopni=None, straz=None):
    """Easter egg: `heat --paladin`. Rysunek i caly meldunek warty pod spodem.

    Trzy poziomy, od najlepszego: prawdziwy obrazek (Ghostty/kitty/WezTerm/iTerm2),
    polbloki w truecolor, filizanka ASCII. `--ascii` wymusza filizanke,
    `--bloki` - polbloki (do podgladu tego, co zobaczy ktos bez grafiki)."""
    protokol = _protokol_obrazkowy()
    grafika = os.path.expanduser("~/.coffee-paladin/paladin_welcome.png")
    if not (protokol and _wyslij_obraz(grafika, protokol)):
        print(PALADIN_KOLOR if _kolorowy_terminal() else PALADIN_MONO)
    print("   coffee-paladin  -  " + MOTTO)
    if ile_stopni is not None:
        print("   %s %.1f C" % ("Na warcie przy" if LANG == "pl" else "Standing watch at",
                                ile_stopni))
    if straz:
        print("   " + straz)
    print("   " + REPO + "\n")
    return 0


def stuck():
    """`heat --stuck`: procesy w stanie T (zatrzymane) i skad sie tam wziely.

    Stan T ma dwie przyczyny i tylko jedna jest w porzadku: pauza guarda (wznowi sam)
    albo pulapka SIGTTIN/SIGTTOU - proces w tle probowal czytac/pisac na terminal,
    dostal stop od jadra i nikt go nie wznowi. Ta druga wyglada jak zawieszenie
    i wlasnie po to jest ta komenda: odroznic jedno od drugiego.
    """
    out = sh(["ps", "-Ao", "pid=,stat=,etime=,comm="])
    zatrzymane = []
    for linia in out.splitlines():
        czesci = linia.split(None, 3)
        if len(czesci) < 4:
            continue
        pid, stat, etime, comm = czesci
        if stat.startswith("T"):
            zatrzymane.append((pid, stat, etime, comm))

    # Kto pauzowal: state.json demona jest zrodlem prawdy (status.json to migawka
    # co N sekund - przy szybkim cyklu pauza/wznowienie proces bywa zatrzymany
    # ZANIM trafi do migawki, i bez tego bysmy krzyczeli na wlasna pauze).
    znane = set()
    for plik, klucz in (("state.json", "paused"), ("status.json", "paused")):
        try:
            with open(os.path.join(BASE, plik)) as f:
                dane = (json.load(f) or {}).get(klucz) or {}
            if isinstance(dane, dict):
                znane.update(str(k) for k in dane)
            else:
                znane.update(str(p.get("pid")) for p in dane)
        except Exception:
            pass
    # ostatnia linia obrony: swiezy wpis w logu guarda o pauzie tego PID-u
    try:
        with open(LOG) as f:
            ogon = f.read()[-4000:]
    except Exception:
        ogon = ""

    if not zatrzymane:
        print(T("No stopped processes. Nothing is waiting for a SIGCONT."))
        return 0

    print(T("Stopped processes (state T):"))
    obce = 0
    for pid, stat, etime, comm in zatrzymane:
        nazwa = os.path.basename(comm)
        if pid in znane or ("(pid %s," % pid) in ogon:
            print(T("   ⏸  %s (pid %s, %s) - paused by coffee-paladin, resumes by itself")
                  % (nazwa, pid, etime))
        else:
            obce += 1
            print(T("   ⚠️  %s (pid %s, %s) - stopped by something else")
                  % (nazwa, pid, etime))
    if obce:
        print(T("\nA process stopped by something else is usually the SIGTTIN trap: a background\n"
                "job touched the terminal and the kernel stopped it. Nothing will resume it.\n"
                "Bring it to the foreground (fg) or resume it: kill -CONT <pid>"))
    return 0


