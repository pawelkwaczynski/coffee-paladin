#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""heat — jednym poleceniem: jak gorący jest Mac i co go grzeje."""

import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
BASE = os.path.join(HOME, ".thermal-guard")
HIST = os.path.join(BASE, "history.csv")
LOG = os.path.join(BASE, "guard.log")
STATE = os.path.join(BASE, "state.json")
AGENT = "pl.pawel.thermal-guard"

ICON = {"nominal": "🟢", "fair": "🟡", "serious": "🟠", "critical": "🔴", "unknown": "⚪️"}


def sh(cmd, timeout=15):
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        out, _ = p.communicate(timeout=timeout)
        return out.decode("utf-8", "replace")
    except Exception:
        return ""


def main():
    state = sh([os.path.join(HOME, ".local/bin/thermalstate")]).strip() or "unknown"
    ioreg = sh(["ioreg", "-r", "-c", "AppleSmartBattery", "-d", "1", "-w", "0"])
    m = re.search(r'"Temperature"\s*=\s*(\d+)', ioreg)
    temp = int(m.group(1)) / 100.0 if m else None
    mmax = re.search(r'"MaximumTemperature"\s*=\s*(\d+)', ioreg)
    # MaximumTemperature jest w calych stopniach (Temperature — inaczej, w setnych)
    lifetime = float(mmax.group(1)) if mmax else None
    sl = re.search(r"CPU_Speed_Limit\s*=\s*(\d+)", sh(["pmset", "-g", "therm"]))
    speed = int(sl.group(1)) if sl else 100
    try:
        l1, l5, l15 = os.getloadavg()
    except Exception:
        l1 = l5 = l15 = 0.0
    ncpu = int(sh(["sysctl", "-n", "hw.ncpu"]).strip() or 8)

    # migawka guarda (chip, wentylatory, zasilanie) — swiezsza niz cokolwiek policzone tutaj
    snap = {}
    try:
        with open(os.path.join(BASE, "status.json")) as f:
            snap = json.load(f)
    except Exception:
        pass
    chip = snap.get("chip_c")
    fans = snap.get("wentylatory") or []

    print("%s stan termiczny: %s   chip: %s   bateria: %s   CPU dostępne: %d%%   load: %.2f / %.2f (rdzeni %d)"
          % (ICON.get(state, "⚪️"), state,
             ("%.1f °C" % chip) if chip else "n/d",
             ("%.1f °C" % temp) if temp else "n/d", speed, l1, l15, ncpu))

    if fans:
        opis = ", ".join("stoi" if f == 0 else "%d obr/min" % f for f in fans)
        ostrz = ""
        if chip and chip >= 75.0 and max(fans) == 0:
            ostrz = "   ⚠️ CHIP GORĄCY, A WENTYLATORY STOJĄ — sprawdź chłodzenie!"
        print("   wentylatory: %s%s" % (opis, ostrz))

    if snap:
        zas = "zasilacz" if snap.get("na_zasilaczu") else "bateria %s%%" % snap.get("bateria_pct", "?")
        watts = snap.get("waty")
        print("   zasilanie: %s%s" % (zas, ("   pobór: %.1f W" % watts) if watts else ""))

    if lifetime:
        print("   rekord temperatury baterii (cały cykl życia): %.1f °C" % lifetime)

    running = AGENT in sh(["launchctl", "list"]) or bool(sh(["pgrep", "-f", "guard.py"]).strip())
    print("   thermal-guard: %s" % ("działa ✅" if running else "NIE DZIAŁA ❌  (launchctl kickstart -k gui/%d/%s)" % (os.getuid(), AGENT)))

    try:
        with open(STATE) as f:
            st = json.load(f)
        if st.get("paused"):
            for k, v in st["paused"].items():
                print("   ⏸  wstrzymane: %s (pid %s, od %s)"
                      % (v.get("comm"), k, time.strftime("%H:%M", time.localtime(v.get("since", 0)))))
    except Exception:
        pass

    print("\nNajwięcej CPU teraz:")
    out = sh(["ps", "-Ao", "pid=,pcpu=,comm=", "-c", "-r"])
    for line in out.splitlines()[:6]:
        p = line.split(None, 2)
        if len(p) == 3:
            print("   %-22s pid %-7s %5s%%" % (p[2][:22], p[0], p[1]))

    # maks. z ostatnich 24 h z historii guarda
    try:
        cutoff = time.time() - 86400
        best, when = None, None
        with open(HIST) as f:
            next(f, None)
            for line in f:
                c = line.split(",")
                if len(c) < 3 or not c[2]:
                    continue
                try:
                    t = time.mktime(time.strptime(c[0], "%Y-%m-%d %H:%M:%S"))
                except Exception:
                    continue
                if t >= cutoff:
                    v = float(c[2])
                    if best is None or v > best:
                        best, when = v, c[0]
        if best:  # kolumna 2 to teraz temperatura CHIPA (wczesniej byla bateria)
            print("\nMax temperatura chipa z ostatnich 24 h: %.1f °C (%s)" % (best, when))
    except Exception:
        pass

    try:
        with open(LOG) as f:
            lines = [l.rstrip() for l in f if any(k in l for k in ("PAUZA", "WZNOWIONE", "STOP", "SIGKILL", "DEMOTE"))]
        if lines:
            print("\nOstatnie interwencje guarda:")
            for l in lines[-5:]:
                print("   " + l)
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
