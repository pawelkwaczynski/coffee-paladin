def czas_abs(s):
    """Epoch ABSOLUTNY ze stempla `ts()` - z offsetem albo bez (pliki sprzed 2.1.8).

    CELOWA KOPIA `guard.czas_abs` - narzedzia w tym projekcie sa samodzielne i nie
    importuja demona. Wszystkie kopie pilnuje `tests/test_spojnosc.py`.
    Bez tolerancji na offset ten parser rzucalby ValueError na KAZDYM nowym wierszu
    history.csv i po cichu pomijal wszystkie swieze pomiary.
    """
    s = (s or "").strip()
    if len(s) < 19:
        return 0.0
    try:
        if len(s) >= 24 and s[19] in "+-":
            return datetime.datetime.strptime(s[:24], "%Y-%m-%d %H:%M:%S%z").timestamp()
        return time.mktime(time.strptime(s[:19], "%Y-%m-%d %H:%M:%S"))
    except (ValueError, OverflowError):
        return 0.0


def _lang():
    v = (os.environ.get("TG_LANG") or "").lower()[:2]
    if v in SUPPORTED_LANGS:
        return v
    try:
        with open(os.path.join(BASE, "config.json")) as f:
            v = (json.load(f).get("lang") or "").lower()[:2]
        if v in SUPPORTED_LANGS:
            return v
    except Exception:
        pass
    return "en"


