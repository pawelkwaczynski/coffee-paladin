def start_guard():
    uid = os.getuid()
    subprocess.call(["launchctl", "kickstart", "-k", "gui/%d/%s" % (uid, AGENT_LABEL)],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
