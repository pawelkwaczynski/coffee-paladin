def czas_abs(s):
    """Return an absolute epoch parsed from `ts()` output.

    Accept timestamps with or without a UTC offset; rows before 2.1.8 have no
    offset. Return 0.0 when the input is not parseable, including non-strings.
    This is an intentional copy of `guard.czas_abs`; tests/test_spojnosc.py keeps
    all copies aligned.
    """
    # Evidence-file parser: it must never raise. One bad row must not abort the
    # whole document. Narrowing `except` to (ValueError, OverflowError) loses
    # tolerance for non-strings: 123 raises AttributeError, b"..." raises TypeError.
    if not isinstance(s, str):
        return 0.0
    s = s.strip()
    if len(s) < 19:
        return 0.0
    try:
        if len(s) >= 24 and s[19] in "+-":
            return datetime.datetime.strptime(s[:24], "%Y-%m-%d %H:%M:%S%z").timestamp()
        return time.mktime(time.strptime(s[:19], "%Y-%m-%d %H:%M:%S"))
    except Exception:      # noqa: BLE001 - contract: never raise
        return 0.0


def _lang():
    v = (os.environ.get("TG_LANG") or "").lower()[:2]
    if v in SUPPORTED_LANGS:
        return v
    try:
        with open(os.path.join(BASE, "config.json")) as f:
            v = (json.load(f).get("lang") or "").lower()[:2]
        if v in SUPPORTED_LANGS:
            return v
    except Exception:
        pass
    return "en"


