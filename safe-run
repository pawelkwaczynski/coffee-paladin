def parse():
    args = sys.argv[1:]
    c = cfg()
    opt = {"hours": float(os.environ.get("SAFE_RUN_HOURS", 6)), "name": None,
           "allow_hot": False, "allow_sleep": False, "wait_cool": False,
           # Defaults from config.json; the menu bar controls them with toggles.
           "normal": (c.get("job_cores_mode") or "efficiency") == "all",
           # 95, not 100: same default as guard DEFAULTS and the documentation.
           "cpu_limit": float(c.get("job_cpu_percent") or 95),
           # 30 s = previous fixed window between SIGTERM and SIGKILL.
           "grace": 30.0}
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        elif a == "--hours" and i + 1 < len(args):
            opt["hours"] = float(args[i + 1]); i += 2
        elif a == "--name" and i + 1 < len(args):
            opt["name"] = args[i + 1]; i += 2
        elif a == "--cpu-limit" and i + 1 < len(args):
            opt["cpu_limit"] = float(args[i + 1]); i += 2
        elif a == "--allow-hot":
            opt["allow_hot"] = True; i += 1
        elif a == "--wait-cool":
            opt["wait_cool"] = True; i += 1
        elif a == "--grace" and i + 1 < len(args):
            opt["grace"] = float(args[i + 1]); i += 2
        elif a == "--normal":
            opt["normal"] = True; i += 1
        elif a == "--efficiency":
            opt["normal"] = False; i += 1
        elif a == "--allow-sleep":
            opt["allow_sleep"] = True; i += 1
        elif a in ("-h", "--help"):
            print(__doc__); sys.exit(0)
        elif a.startswith("-"):
            print(T("safe-run: unknown option %s") % a); sys.exit(2)
        else:
            break
    cmd = args[i:]
    if not cmd:
        print(__doc__)
        sys.exit(2)
    opt["name"] = opt["name"] or os.path.basename(cmd[0])
    opt["cpu_limit"] = min(max(opt["cpu_limit"], 10.0), 100.0)
    # Cap at 1 h: a "grace window" longer than an hour is effectively no limit.
    opt["grace"] = min(max(opt["grace"], 0.0), 3600.0)
    return opt, cmd


def migawka_swieza(nazwa, max_wiek=120):
    """Return whether a daemon snapshot is fresh enough to mean anything.

    `max_wiek` is seconds. False means the file is missing, stale, or unreadable.
    A stale snapshot means no daemon is available to decide - never "stay
    stopped". A daemon that died while the machine was hot leaves status.json
    frozen at level 2 forever; a limiter that kept asking that corpse for
    permission to resume would leave the job in state T until the time budget
    executed it. Checking freshness here is what breaks that trap.
    """
    try:
        return (time.time() - os.path.getmtime(os.path.join(BASE, nazwa))) <= max_wiek
    except Exception:
        return False


def guard_paused(pid):
    """Return whether the guard paused this job or anything in its process group.

    False also means `state.json` is missing, stale, unreadable, or has no
    matching live entry. A stale snapshot means "no daemon can decide", not
    "stay stopped". The caller must not SIGCONT a group while this returns true.

    The check covers the WHOLE group, not the bare pid: the guard freezes the
    process that generates heat, which is usually a child (ffmpeg), not our
    group leader. Comparing only `proc.pid` returned False, so the limiter's
    micro-pause ended with killpg(SIGCONT) and woke the very process the guard
    had just frozen; once the chip cooled, the limiter resumed the job behind
    the guard's back while the guard still counted it as paused and eventually
    sent SIGTERM at the pause limit.
    """
    if not migawka_swieza("state.json"):
        return False
    try:
        with open(os.path.join(BASE, "state.json")) as f:
            paused = json.load(f).get("paused") or {}
        if not paused:
            return False
        try:
            moja_grupa = os.getpgid(pid)
        except OSError:
            return False
        if str(pid) in paused:
            # A PID match still needs proof. PID numbers are recycled, so the
            # entry may describe a dead process whose number we now have. The
            # saved pgid must match today's process group; an invalid pgid
            # invalidates only this entry.
            wpis = paused[str(pid)]
            zapisany = wpis.get("pgid") if isinstance(wpis, dict) else None
            try:
                if zapisany is None or int(zapisany) == moja_grupa:
                    return True
            except (TypeError, ValueError):
                pass                              # malformed entry cannot stop us
        for k, v in paused.items():
            # A DEAD ENTRY MUST NOT STOP US. Process group numbers are recycled.
            # If an entry from a long-dead job survived in state.json, a new
            # safe-run with the same pgid would wait forever for a guard decision
            # that does not apply to it. A live PID is cheap proof that the entry
            # still describes something real.
            try:
                os.kill(int(k), 0)
            except ValueError:
                continue
            except ProcessLookupError:
                continue
            except PermissionError:
                pass                              # another user's process, but alive
            except OSError:
                continue
            # THE SAVED GROUP MUST BE THIS PROCESS'S GROUP TODAY. Process group
            # numbers are recycled: a live unrelated process whose saved `pgid`
            # equals ours would make the limiter wait for a guard decision that
            # will never come, leaving our job in state T after a micro-pause.
            # Ask the system, not the note.
            try:
                teraz = os.getpgid(int(k))
            except (OSError, ValueError):
                continue
            # ONE malformed entry (non-numeric pgid) must not blind the limiter
            # to a real pause in a later entry. Skip the bad entry and keep
            # reading.
            zapisany = v.get("pgid") if isinstance(v, dict) else None
            try:
                if zapisany is not None and int(zapisany) != teraz:
                    continue                      # entry now describes something else
            except (TypeError, ValueError):
                continue                          # malformed entry: skip only this one
            if teraz == moja_grupa:
                return True
        return False
    except Exception:
        return False


def guard_hot():
    """Return whether the guard publishes level >=2, meaning hot.

    When this is true, only the guard may resume the job.
    """
    # Close the remaining race: the guard may have sent SIGSTOP before writing
    # state.json. The level in status.json is enough to keep the limiter from
    # waking the group.
    if not migawka_swieza("status.json"):
        return False
    try:
        with open(os.path.join(BASE, "status.json")) as f:
            return (json.load(f).get("level") or 0) >= 2
    except Exception:
        return False


def chip_juz_goracy():
    """Return whether the chip is already near the pause threshold.

    Use the guard snapshot, not ProcessInfo.thermalState. Return (hot, reason);
    reason is suitable for a refusal message and empty when no reason is known.
    """
    # ProcessInfo.thermalState can report "nominal" on Apple Silicon at 92 C when
    # macOS believes the fans are handling it. The guard's own level and chip
    # temperature are the safety contract for starting heavy jobs.
    try:
        with open(os.path.join(BASE, "status.json")) as f:
            st = json.load(f)
        if not isinstance(st, dict):
            return False, ""      # snapshot may be null/list/text after manual editing
    except Exception:
        return False, ""          # no snapshot: do not block; the guard will warn
    if (time.time() - os.path.getmtime(os.path.join(BASE, "status.json"))) > 120:
        # A stale snapshot does not mean "cool". It means the daemon is probably
        # dead, so nobody will supervise this job's temperature. Still do not
        # block: safe-run must work where the daemon is absent, but the user must
        # be told explicitly.
        return False, "STALE"
    try:
        if float(st.get("level") or 0) >= 2:
            return True, T("the guard reports a hot machine")
    except (TypeError, ValueError, OverflowError):
        pass                      # non-numeric level: continue to temperature
    chip = st.get("chip_c")
    # The guard publishes thresholds as {"pause": ..., "kill": ...} (guard.py, status_write).
    # This used to read "soc_pause_c", a key nobody writes. It always returned
    # None and silently fell back to config. On a fanless Mac where calibration
    # lowers the pause threshold to 78 C, that made the decision use 85 C.
    progi = st.get("thresholds")
    prog = (progi.get("pause") if isinstance(progi, dict) else None) or cfg().get("soc_pause_c", 85.0)
    try:
        c, p = float(chip), float(prog)
        if c == c and c >= p - 5.0:          # c == c filters NaN
            return True, "chip %.1f C" % c
    except (TypeError, ValueError, OverflowError):
        pass
    return False, ""


def chip_odczyt():
    """Return (chip_c, resume_threshold_c, level) from a fresh guard snapshot.

    Temperatures are degrees C. chip_c is None when the snapshot is stale,
    missing, unreadable, or has no usable chip reading. level is None when
    missing or not an integer. The resume threshold falls back to 76.0 C.
    """
    # Read thresholds from the snapshot, not config.json: sanity-clamp can
    # correct daemon thresholds in memory (`config_corrections`), so the file may
    # describe a system that is not running. Level is separate because the guard
    # can stay hot for reasons chip temperature does not show, such as throttling
    # or battery state.
    try:
        sciezka = os.path.join(BASE, "status.json")
        with open(sciezka) as f:
            st = json.load(f)
        if not isinstance(st, dict) or (time.time() - os.path.getmtime(sciezka)) > 120:
            st = {}
    except Exception:
        st = {}
    progi = st.get("thresholds")
    prog = (progi.get("resume") if isinstance(progi, dict) else None) or cfg().get("soc_resume_c", 76.0)
    try:
        prog = float(prog)
    except (TypeError, ValueError):
        prog = 76.0
    try:
        chip = float(st.get("chip_c"))
        if chip != chip:                      # NaN
            chip = None
    except (TypeError, ValueError):
        chip = None
    try:
        lvl = int(st.get("level"))
    except (TypeError, ValueError):
        lvl = None
    return chip, prog, lvl


# Poll interval for --wait-cool. The environment variable exists for tests:
# a real one-minute sleep loop is not testable in reasonable time.
WAIT_POLL_S = float(os.environ.get("SAFE_RUN_WAIT_POLL", 60))


def czekaj_na_ochlodzenie(limit):
    """Block until the machine cools down and return waited minutes.

    The target is the guard's resume threshold, not "pause threshold minus 5":
    a job started just under the pause threshold gets SIGSTOP within seconds
    and crawls in a pause-resume cycle. The resume threshold is the level at
    which the guard itself considers work safe, so it carries real headroom.
    Battery temperature and thermalState use the same rules as the normal start
    gate.
    """
    t0 = time.time()
    ostatni_komunikat = 0.0
    while True:
        chip, prog, lvl = chip_odczyt()
        stan = thermal_state()
        bat = batt_temp()
        powody = []
        if stan in HOT:
            powody.append("thermalState=%s" % stan)
        if bat is not None and bat >= limit - 2:
            powody.append("batt %.1f C" % bat)
        if chip is not None and chip > prog:
            powody.append("chip %.1f C > %.0f C" % (chip, prog))
        # Same condition as the start gate: guard level "hot" counts even with a
        # cool chip (throttling, battery). Without it, waiting could end
        # immediately and start the job straight into a pause loop.
        if lvl is not None and lvl >= 2:
            powody.append("guard level %d" % lvl)
        if not powody:
            return (time.time() - t0) / 60.0
        # Print once at the start and then about every 10 min. Overnight queue
        # logs must show that waiting is alive without flooding the file with
        # identical lines.
        if not ostatni_komunikat or time.time() - ostatni_komunikat >= 600.0:
            print(T("safe-run: --wait-cool - the Mac is hot (%s), waiting until it "
                    "cools down (checking every 60 s)") % ", ".join(powody))
            sys.stdout.flush()
            ostatni_komunikat = time.time()
        time.sleep(WAIT_POLL_S)


def limited_wait(proc, pct, deadline):
    """Wait for the job and enforce a CPU limit with process-group micro-pauses.

    The window is 2 s. At pct=95, the group gets SIGSTOP for 100 ms and then
    SIGCONT. At pct>=100, this is a normal wait. Return (rc, killed_by_time).
    """
    window = 2.0
    run_t = window * pct / 100.0
    stop_t = window - run_t
    while True:
        rc = proc.poll()
        if rc is not None:
            return rc, False
        if time.time() > deadline:
            return None, True
        if stop_t < 0.02 or guard_paused(proc.pid):
            time.sleep(2)
            continue
        # No sleep may outlive the time budget; maximum overrun is 50 ms.
        time.sleep(min(run_t, max(deadline - time.time(), 0.05)))
        if proc.poll() is not None or guard_paused(proc.pid):
            continue
        try:
            os.killpg(proc.pid, signal.SIGSTOP)
            time.sleep(min(stop_t, max(deadline - time.time(), 0.05)))
        finally:
            # Do not wake a job frozen by the guard or while the guard publishes
            # "hot" (level >=2). In that state, resume belongs only to the guard.
            if not guard_paused(proc.pid) and not guard_hot():
                try:
                    os.killpg(proc.pid, signal.SIGCONT)
                except Exception:
                    pass


def max_temp_since(t0):
    best = None
    try:
        with open(HIST) as f:
            next(f, None)
            for line in f:
                p = line.split(",")
                if len(p) < 3 or not p[2]:
                    continue
                try:
                    when = czas_abs(p[0])
                    if not when:
                        continue
                except Exception:
                    continue
                if when >= t0:
                    v = float(p[2])
                    best = v if best is None or v > best else best
    except Exception:
        pass
    return best


def zywi_w_grupie(pgid):
    """Return live PIDs in a job process group.

    safe-run itself is in another group. None means unknown: pgrep failed or
    could not read the process table. None is not the same as an empty list;
    cleanup must not skip SIGKILL for an orphan because discovery failed.
    """
    try:
        p = subprocess.run(["pgrep", "-g", str(pgid)], capture_output=True, timeout=10)
    except Exception:
        return None
    if p.returncode == 1:                     # pgrep: no matches
        return []
    if p.returncode != 0:                     # pgrep: error, not an empty group
        return None
    pids = []
    for czesc in p.stdout.decode("utf-8", "replace").split():
        try:
            pids.append(int(czesc))
        except ValueError:
            pass
    return pids


def sprzatnij_grupe(pgid, grace):
    """Send SIGCONT and SIGTERM to the group, then SIGKILL survivors after grace.

    `grace` is seconds. SIGCONT is sent first because SIGTERM delivered to a
    process stopped by the guard stays pending until resume.
    """
    try:
        os.killpg(pgid, signal.SIGCONT)
        os.killpg(pgid, signal.SIGTERM)
    except Exception:
        pass
    koniec = time.time() + grace
    while time.time() < koniec:
        # Only an explicitly empty group exits early. None (pgrep failed) waits
        # until SIGKILL; firing at an empty group is safer than skipping a live one.
        if zywi_w_grupie(pgid) == []:
            return
        time.sleep(1)
    if zywi_w_grupie(pgid) != []:
        try:
            os.killpg(pgid, signal.SIGKILL)
        except Exception:
            pass


def guard_zyje():
    """Return whether the daemon is really alive, not only loaded in launchd.

    `launchctl list` can print "-  1  pl.pawel.coffee-paladin" for a dead job.
    Check the PID column, matching install.sh (`ma_pid`). Fall back to the real
    binary name, not only "guard.py".
    """
    for linia in sh(["launchctl", "list"]).splitlines():
        czesci = linia.split()
        if len(czesci) >= 3 and czesci[2] == AGENT_LABEL and czesci[0] != "-":
            return True
    return bool(sh(["pgrep", "-f", "coffee-paladin$"]).strip()
                or sh(["pgrep", "-f", "guard.py"]).strip())


def main():
    opt, cmd = parse()

    # Nested safe-run: a script launched by safe-run calls safe-run itself.
    # Without this, the inner wrapper ran `setsid` again and the real work landed
    # in a third process group, while the outer wrapper registered a group
    # containing only the inner supervisor. Observed effect: SIGSTOP froze the
    # supervisor while ffmpeg kept heating; the CPU limit did not work because
    # the supervisor was stopped 90% of the time while the work ran at 100%;
    # escalation killed the supervisor instead of the job. This exact layout
    # exists in the compression queue.
    # Solution: the second safe-run does not create its own supervision. It
    # replaces itself with the command via execvp. One session, one registration,
    # one owner.
    if os.environ.get("TG_SAFE_RUN_PGID") and cmd:
        print(T("safe-run: already inside a supervised job - running the command directly"))
        sys.stdout.flush()
        try:
            os.execvp(cmd[0], cmd)
        except OSError as e:
            print("safe-run: %s: %s" % (cmd[0], e), file=sys.stderr)
            return 127

    for d in (BASE, MANAGED_DIR):
        # exist_ok: several safe-run instances starting at once on a fresh install
        # made three out of four fail with FileExistsError, and those jobs never
        # started.
        os.makedirs(d, 0o700, exist_ok=True)   # see guard.ensure_dirs: not public

    state, temp = thermal_state(), batt_temp()
    limit = cfg().get("batt_pause_c", 40.0)
    chip_hot, chip_powod = chip_juz_goracy()
    if chip_powod == "STALE":
        chip_powod = ""
        print(T("safe-run: WARNING - the guard's snapshot is stale, the daemon is probably "
                "not running. This job will start, but NOTHING will supervise its "
                "temperature."), file=sys.stderr)
    hot = state in HOT or (temp is not None and temp >= limit - 2) or chip_hot
    print(T("safe-run: thermal state=%s, battery=%s, time budget=%.1f h") % (
        state, ("%.1f C" % temp) if temp else T("n/a"), opt["hours"]))
    print(T("safe-run: cores=%s, CPU limit=%d%%") % (
        T("all") if opt["normal"] else T("efficiency only"), int(opt["cpu_limit"])))
    if hot and not opt["allow_hot"]:
        if not opt["wait_cool"]:
            print(T("safe-run: REFUSING TO START - the Mac is already hot. Use --wait-cool to wait, let it cool down, or pass --allow-hot.")
                  + ((" (%s)" % chip_powod) if chip_powod else ""))
            return 3
        # Waiting DOES NOT consume the --hours budget: t0, the job deadline,
        # starts below after cooldown. Ctrl-C while waiting is a normal manual
        # interruption (rc 130, same contract as retry_run.sh: do not retry).
        try:
            minuty = czekaj_na_ochlodzenie(limit)
        except KeyboardInterrupt:
            return 130
        print(T("safe-run: cooled down after %d min - starting the job") % round(minuty))
        sys.stdout.flush()

    if not guard_running():
        print(T("safe-run: coffee-paladin is not running - trying to start it..."))
        if not start_guard():
            print(T("safe-run: WARNING - the guard did not start, this job will NOT be supervised.")
                  + "  launchctl kickstart -k gui/$UID/%s" % AGENT_LABEL)

    wrapped = list(cmd)
    if not opt["normal"]:
        # Background QoS (E-cores) + nice: the cheapest thermal form of long compute.
        wrapped = ["nice", "-n", "10", "taskpolicy", "-b"] + wrapped

    t0 = time.time()
    try:
        srodowisko = dict(os.environ)
        srodowisko["TG_SAFE_RUN_PGID"] = str(os.getpid())   # see note in main()
        proc = subprocess.Popen(wrapped, preexec_fn=os.setsid, env=srodowisko)
    except Exception as e:
        print(T("safe-run: cannot start: %r") % (e,))
        return 4

    # Sleep in the middle of a job leaves it stuck until morning.
    # `caffeinate -is -w PID` exits with the job, so there is nothing to track or
    # clean up.
    if not opt["allow_sleep"]:
        try:
            subprocess.Popen(["caffeinate", "-is", "-w", str(proc.pid)],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass          # no sleep lock is worse, but the job should start

    reg = os.path.join(MANAGED_DIR, "%d.json" % proc.pid)
    # 0600: the file contains the FULL command line: project paths, file names,
    # and sometimes tokens in arguments. On a Mac with multiple accounts, only
    # the owner should read it.
    _fd = os.open(reg, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(_fd, "w") as f:
        # "normal": the user explicitly asked for all cores. The guard must not
        # silently undo that decision five minutes later by demoting the job to
        # E-cores.
        json.dump({"pid": proc.pid, "pgid": proc.pid, "name": opt["name"],
                   "cmd": cmd, "started": t0, "hours": opt["hours"],
                   "normal": bool(opt["normal"])}, f, indent=1)

    def forward(signum, frame):
        try:
            os.killpg(proc.pid, signum)
        except Exception:
            pass

    signal.signal(signal.SIGINT, forward)
    signal.signal(signal.SIGTERM, forward)

    deadline = t0 + opt["hours"] * 3600
    rc, killed_by_time = limited_wait(proc, opt["cpu_limit"], deadline)
    if killed_by_time:
        print(T("safe-run: TIME BUDGET %.1f h reached - terminating the job (SIGTERM)") % opt["hours"])
        # Cleanup checks the WHOLE group, not proc.poll(): if the leader died
        # while grandchildren were alive, SIGKILL used to be skipped and the
        # grandchildren stayed forever.
        sprzatnij_grupe(proc.pid, opt["grace"])
        rc = proc.wait()

    # Leftover group members at exit. If the leader dies from an external signal
    # (kill of one pid, not killpg), children in the group keep running without a
    # time budget and without registration, because it is removed below. Also
    # clean up rc >= 128: a shell leader that catches SIGTERM exits as
    # 128+signal and leaves the same orphan. After a clean exit, the job may have
    # intentionally left something in the background; warn loudly but do not
    # touch it.
    # After killed_by_time, the group already had the full grace window and
    # SIGKILL. A second cleanup cannot kill anything SIGKILL did not kill, so
    # only report.
    resztki = zywi_w_grupie(proc.pid)
    if resztki:
        smierc_od_sygnalu = rc is not None and (rc < 0 or rc >= 128)
        if smierc_od_sygnalu and not killed_by_time:
            print(T("safe-run: cleaning up %d leftover process(es) from the job's group (SIGTERM, then SIGKILL after %d s)")
                  % (len(resztki), int(opt["grace"])))
            sprzatnij_grupe(proc.pid, opt["grace"])
        else:
            print(T("safe-run: WARNING - the job left %d process(es) running in its group (pids: %s) - no time budget applies to them")
                  % (len(resztki), ", ".join(str(p) for p in resztki)))

    try:
        os.unlink(reg)
    except Exception:
        pass

    dur = time.time() - t0
    mx = max_temp_since(t0)
    print(T("safe-run: %s - exit code %s, took %dh %dm, peak temperature %s%s") % (
        opt["name"], rc, int(dur // 3600), int(dur % 3600 // 60),
        ("%.1f C" % mx) if mx else T("n/a"),
        (", " + T("terminated by the time budget")) if killed_by_time else ""))
    if rc is not None and rc < 0 and -rc in (signal.SIGTERM, signal.SIGKILL):
        print(T("safe-run: the job was stopped by signal %d - check ~/.coffee-paladin/guard.log") % -rc)
    # A job killed by signal returns a negative rc (-15 SIGTERM, -9 SIGKILL).
    # Returning 0 made `safe-run ... && next_step` continue after a half-finished
    # job, for example a compression queue deleting the source after an
    # incomplete encode. 128+signal is the shell convention for "killed by signal".
    if rc and rc < 0:
        return 128 - rc
    return rc if rc and rc > 0 else 0


if __name__ == "__main__":
    sys.exit(main())
