def sh(cmd, timeout=15):
    # After a timeout, the child must be killed: communicate() only raises, and
    # the process keeps running. In the daemon this left hung macmon processes and
    # stopped the loop. The same failure would be quieter here.
    p = None
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        out, _ = p.communicate(timeout=timeout)
        return out.decode("utf-8", "replace")
    except Exception:
        if p is not None and p.poll() is None:
            try:
                p.kill()
                p.communicate(timeout=2)
            except Exception:
                pass
        return ""


def thermal_state():
    out = sh([THERMALSTATE]).strip()
    return out if out else "unknown"


def batt_temp():
    import re
    out = sh(["ioreg", "-r", "-c", "AppleSmartBattery", "-d", "1", "-w", "0"])
    m = re.search(r'"Temperature"\s*=\s*(\d+)', out)
    if not m:
        return None
    # Same normalization as the guard: controllers report hundredths, tenths, or
    # whole degrees. Hardcoding /100 produced 4.4 C instead of 44 C, so the
    # battery start gate never fired on that Mac.
    v = float(m.group(1))
    for _ in range(4):
        if v <= 100.0:
            break
        v /= 10.0
    return v if 0.0 < v <= 100.0 else None


