def cfg():
    d = {"batt_pause_c": 40.0}
    try:
        with open(os.path.join(BASE, "config.json")) as f:
            d.update(json.load(f))
    except Exception:
        pass
    return d


def sh(cmd, timeout=15):
    # Po timeoucie trzeba dziecko ZABIC: communicate() tylko rzuca wyjatek, a proces
    # zyje dalej. W demonie konczylo sie to czworka wiszacych macmonow i zatrzymana
    # petla (02.08.2026) - tutaj byloby to samo, tylko ciszej.
    p = None
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        out, _ = p.communicate(timeout=timeout)
        return out.decode("utf-8", "replace")
    except Exception:
        if p is not None and p.poll() is None:
            try:
                p.kill()
                p.communicate(timeout=2)
            except Exception:
                pass
        return ""


def thermal_state():
    out = sh([THERMALSTATE]).strip()
    return out if out else "unknown"


def batt_temp():
    import re
    out = sh(["ioreg", "-r", "-c", "AppleSmartBattery", "-d", "1", "-w", "0"])
    m = re.search(r'"Temperature"\s*=\s*(\d+)', out)
    if not m:
        return None
    # Ta sama normalizacja co w guardzie: kontrolery raportuja setne, dziesiate albo
    # cale stopnie. Sztywne /100 dawalo 4,4 stopnia zamiast 44 - i bateryjna bramka
    # odmowy startu nie odpalala sie na takim Macu NIGDY.
    v = float(m.group(1))
    for _ in range(4):
        if v <= 100.0:
            break
        v /= 10.0
    return v if 0.0 < v <= 100.0 else None


