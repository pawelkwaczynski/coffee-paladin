def start_guard():
    uid = os.getuid()
    subprocess.call(["launchctl", "kickstart", "-k", "gui/%d/%s" % (uid, AGENT_LABEL)],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(1)
    return guard_running()


def parse():
    args = sys.argv[1:]
    c = cfg()
    opt = {"hours": float(os.environ.get("SAFE_RUN_HOURS", 6)), "name": None,
           "allow_hot": False, "allow_sleep": False,
           # defaulty z config.json — pasek menu ustawia je przelacznikami
           "normal": (c.get("job_cores_mode") or "efficiency") == "all",
           # 95, nie 100: ten sam default co w DEFAULTS guarda i w dokumentacji
           "cpu_limit": float(c.get("job_cpu_percent") or 95)}
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        elif a == "--hours" and i + 1 < len(args):
            opt["hours"] = float(args[i + 1]); i += 2
        elif a == "--name" and i + 1 < len(args):
            opt["name"] = args[i + 1]; i += 2
        elif a == "--cpu-limit" and i + 1 < len(args):
            opt["cpu_limit"] = float(args[i + 1]); i += 2
        elif a == "--allow-hot":
            opt["allow_hot"] = True; i += 1
        elif a == "--normal":
            opt["normal"] = True; i += 1
        elif a == "--efficiency":
            opt["normal"] = False; i += 1
        elif a == "--allow-sleep":
            opt["allow_sleep"] = True; i += 1
        elif a in ("-h", "--help"):
            print(__doc__); sys.exit(0)
        elif a.startswith("-"):
            print(T("safe-run: unknown option %s") % a); sys.exit(2)
        else:
            break
    cmd = args[i:]
    if not cmd:
        print(__doc__)
        sys.exit(2)
    opt["name"] = opt["name"] or os.path.basename(cmd[0])
    opt["cpu_limit"] = min(max(opt["cpu_limit"], 10.0), 100.0)
    return opt, cmd


def migawka_swieza(nazwa, max_wiek=120):
    """Czy plik demona jest na tyle swiezy, zeby mial cokolwiek znaczyc?

    Bramka startowa sprawdzala wiek migawki, a petla limitera juz nie - i to bylo
    grozne. Gdy demon zginal w chwili, gdy bylo goraco, `status.json` z poziomem 2
    zostawal zamrozony w czasie NA ZAWSZE. Limiter po wlasnej mikro-pauzie pytal
    niezyjacego demona o zgode na wznowienie, nie dostawal jej i nie budzil grupy.
    Zadanie stalo w stanie T az do wyczerpania budzetu czasu (domyslnie 6 h), a potem
    dostawalo SIGTERM - czyli jedynym wyjsciem byla egzekucja, nie wznowienie.
    Nieswieza migawka znaczy "nie ma komu decydowac": limiter wraca do wlasnych regul.
    """
    try:
        return (time.time() - os.path.getmtime(os.path.join(BASE, nazwa))) <= max_wiek
    except Exception:
        return False


def guard_paused(pid):
    """Czy TEN pid jest aktualnie wstrzymany przez guarda (state.json)?

    Limiter nie moze wyslac SIGCONT zadaniu, ktore zamrozil bezpiecznik —
    o pauzie termicznej decyduje wylacznie guard. ALE tylko dopoki guard zyje:
    nieswieza migawka znaczy "nie ma komu decydowac", nie "trzymaj zamrozone".
    """
    if not migawka_swieza("state.json"):
        return False
    try:
        with open(os.path.join(BASE, "state.json")) as f:
            return str(pid) in (json.load(f).get("paused") or {})
    except Exception:
        return False


def guard_hot():
    """Czy guard publikuje poziom >=2 (goraco)? Wtedy wznowienie nalezy do guarda.

    Domyka szczatkowy wyscig: guard mogl wyslac SIGSTOP, ale jeszcze nie zapisac
    state.json — sam poziom w status.json wystarcza, zeby limiter nie budzil grupy.
    """
    if not migawka_swieza("status.json"):
        return False
    try:
        with open(os.path.join(BASE, "status.json")) as f:
            return (json.load(f).get("level") or 0) >= 2
    except Exception:
        return False


def chip_juz_goracy():
    """Czy chip jest juz przy progu pauzy — wedlug migawki guarda.

    thermal_state() (ProcessInfo.thermalState) na Apple Silicon potrafi pokazywac
    "nominal" przy chipie na 92 C: system uznaje, ze radzi sobie wentylatorami.
    Sprawdzone 02.08.2026 — safe-run wystartowal zadanie na maszynie, na ktorej
    guard pauzowal ffmpeg co kilkanascie sekund. Dlatego pytamy o to, co guard
    naprawde mierzy: jego wlasny poziom i temperature chipa wzgledem progu pauzy.

    Zwraca (goraco, powod) — powod idzie do komunikatu, zeby odmowa byla zrozumiala.
    """
    try:
        with open(os.path.join(BASE, "status.json")) as f:
            st = json.load(f)
        if not isinstance(st, dict):
            return False, ""      # migawka moze byc null/lista/tekst po recznej edycji
    except Exception:
        return False, ""          # brak migawki: nie blokujemy, guard i tak ostrzeze
    if (time.time() - os.path.getmtime(os.path.join(BASE, "status.json"))) > 120:
        return False, ""          # migawka nieswieza: nie ma na czym opierac decyzji
    try:
        if float(st.get("level") or 0) >= 2:
            return True, T("the guard reports a hot machine")
    except (TypeError, ValueError, OverflowError):
        pass                      # poziom nie-liczbowy: idziemy dalej, do temperatury
    chip = st.get("chip_c")
    # Guard publikuje progi jako {"pause": ..., "kill": ...} (guard.py, status_write).
    # Wczesniej bylo tu "soc_pause_c", czyli klucz, ktorego nikt nie zapisuje - odczyt
    # zawsze zwracal None i po cichu spadal na config. Na maszynie bezwentylatorowej,
    # gdzie kalibracja obniza prog do 78 C, oznaczalo to decyzje wedlug 85 C.
    progi = st.get("thresholds")
    prog = (progi.get("pause") if isinstance(progi, dict) else None) or cfg().get("soc_pause_c", 85.0)
    try:
        c, p = float(chip), float(prog)
        if c == c and c >= p - 5.0:          # c == c odsiewa NaN
            return True, "chip %.1f C" % c
    except (TypeError, ValueError, OverflowError):
        pass
    return False, ""


def limited_wait(proc, pct, deadline):
    """Czeka na koniec zadania, wymuszajac limit CPU mikropauzami calej grupy.

    Okno 2 s: przy pct=95 grupa dostaje SIGSTOP na 100 ms i SIGCONT z powrotem —
    dziala dla kazdego programu, takze takiego, ktory ignoruje opcje watkow.
    Przy pct>=100 zwykle czekanie. Zwraca (rc, killed_by_time).
    """
    window = 2.0
    run_t = window * pct / 100.0
    stop_t = window - run_t
    while True:
        rc = proc.poll()
        if rc is not None:
            return rc, False
        if time.time() > deadline:
            return None, True
        if stop_t < 0.02 or guard_paused(proc.pid):
            time.sleep(2)
            continue
        # zaden sleep nie moze przespac budzetu czasu (max przekroczenie: 50 ms)
        time.sleep(min(run_t, max(deadline - time.time(), 0.05)))
        if proc.poll() is not None or guard_paused(proc.pid):
            continue
        try:
            os.killpg(proc.pid, signal.SIGSTOP)
            time.sleep(min(stop_t, max(deadline - time.time(), 0.05)))
        finally:
            # nie budzimy zadania, ktore zamrozil guard ANI gdy guard publikuje "goraco"
            # (poziom >=2) — wtedy wznowienie jest wylacznie decyzja bezpiecznika
            if not guard_paused(proc.pid) and not guard_hot():
                try:
                    os.killpg(proc.pid, signal.SIGCONT)
                except Exception:
                    pass


def max_temp_since(t0):
    best = None
    try:
        with open(HIST) as f:
            next(f, None)
            for line in f:
                p = line.split(",")
                if len(p) < 3 or not p[2]:
                    continue
                try:
                    when = czas_abs(p[0])
                    if not when:
                        continue
                except Exception:
                    continue
                if when >= t0:
                    v = float(p[2])
                    best = v if best is None or v > best else best
    except Exception:
        pass
    return best


def guard_zyje():
    """Czy demon NAPRAWDE zyje, a nie tylko jest wczytany do launchd.

    `launchctl list` dla martwego joba drukuje "-  1  pl.pawel.coffee-paladin", wiec
    zwykle sprawdzenie podciagu bylo prawdziwe takze wtedy, gdy demon wpadl w petle
    restartow. `heat` meldowal "dziala", a `safe-run` nie ostrzegal, ze zadanie
    poleci BEZ nadzoru. Sprawdzamy kolumne PID - install.sh robi to samo (ma_pid).
    Zapasowo szukamy procesu po realnej nazwie binarki, nie po "guard.py".
    """
    for linia in sh(["launchctl", "list"]).splitlines():
        czesci = linia.split()
        if len(czesci) >= 3 and czesci[2] == AGENT_LABEL and czesci[0] != "-":
            return True
    return bool(sh(["pgrep", "-f", "coffee-paladin$"]).strip()
                or sh(["pgrep", "-f", "guard.py"]).strip())


def main():
    opt, cmd = parse()

    # ZAGNIEZDZONY safe-run: skrypt uruchomiony przez safe-run sam wola safe-run.
    # Bez tego wewnetrzny robil `setsid` po raz drugi i prawdziwa praca ladowala
    # w TRZECIEJ grupie procesow, podczas gdy zewnetrzny mial zarejestrowana grupe
    # zawierajaca wylacznie wewnetrznego NADZORCE. Skutek zmierzony na zywo:
    # SIGSTOP zamrazal nadzorce, a ffmpeg grzal dalej; limit CPU nie dzialal w ogole
    # (nadzorca stal 90% czasu, praca leciala 100%); eskalacja ubijala nadzorce
    # zamiast zadania. Dokladnie ten uklad jest w kolejce kompresji.
    # Rozwiazanie: drugi safe-run nie tworzy wlasnego nadzoru, tylko PODMIENIA sie
    # na polecenie (execvp). Zostaje jedna sesja, jedna rejestracja, jeden wlasciciel.
    if os.environ.get("TG_SAFE_RUN_PGID") and cmd:
        print(T("safe-run: already inside a supervised job - running the command directly"))
        sys.stdout.flush()
        try:
            os.execvp(cmd[0], cmd)
        except OSError as e:
            print("safe-run: %s: %s" % (cmd[0], e), file=sys.stderr)
            return 127

    for d in (BASE, MANAGED_DIR):
        # exist_ok: przy kilku safe-run odpalonych naraz na swiezej instalacji trzy
        # z czterech wywalaly sie FileExistsError i zadania w ogole nie ruszaly
        os.makedirs(d, 0o700, exist_ok=True)   # patrz guard.ensure_dirs: nie publiczne

    state, temp = thermal_state(), batt_temp()
    limit = cfg().get("batt_pause_c", 40.0)
    chip_hot, chip_powod = chip_juz_goracy()
    hot = state in HOT or (temp is not None and temp >= limit - 2) or chip_hot
    print(T("safe-run: thermal state=%s, battery=%s, time budget=%.1f h") % (
        state, ("%.1f C" % temp) if temp else T("n/a"), opt["hours"]))
    print(T("safe-run: cores=%s, CPU limit=%d%%") % (
        T("all") if opt["normal"] else T("efficiency only"), int(opt["cpu_limit"])))
    if hot and not opt["allow_hot"]:
        print(T("safe-run: REFUSING TO START - the Mac is already hot. Let it cool down or pass --allow-hot.")
              + ((" (%s)" % chip_powod) if chip_powod else ""))
        return 3

    if not guard_running():
        print(T("safe-run: coffee-paladin is not running - trying to start it..."))
        if not start_guard():
            print(T("safe-run: WARNING - the guard did not start, this job will NOT be supervised.")
                  + "  launchctl kickstart -k gui/$UID/%s" % AGENT_LABEL)

    wrapped = list(cmd)
    if not opt["normal"]:
        # background QoS (E-cores) + nice: najtansza termicznie forma dlugiego liczenia
        wrapped = ["nice", "-n", "10", "taskpolicy", "-b"] + wrapped

    t0 = time.time()
    try:
        srodowisko = dict(os.environ)
        srodowisko["TG_SAFE_RUN_PGID"] = str(os.getpid())   # patrz uwaga w main()
        proc = subprocess.Popen(wrapped, preexec_fn=os.setsid, env=srodowisko)
    except Exception as e:
        print(T("safe-run: cannot start: %r") % (e,))
        return 4

    # Sen w polowie zadania = zadanie stoi do rana. `caffeinate -is -w PID` konczy sie
    # sam razem z zadaniem, wiec nie ma czego pilnowac ani sprzatac - stad brak uchwytu.
    if not opt["allow_sleep"]:
        try:
            subprocess.Popen(["caffeinate", "-is", "-w", str(proc.pid)],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass          # bez blokady snu jest gorzej, ale zadanie ma ruszyc

    reg = os.path.join(MANAGED_DIR, "%d.json" % proc.pid)
    # 0600: plik zawiera PELNA linie polecen zadania - sciezki projektow, nazwy plikow,
    # czasem tokeny w argumentach. Na Macu z kilkoma kontami nie ma powodu, zeby czytal
    # to ktokolwiek poza wlascicielem.
    _fd = os.open(reg, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(_fd, "w") as f:
        # "normal": czlowiek jawnie kazal leciec na wszystkich rdzeniach - guard
        # nie moze 5 minut pozniej po cichu cofnac tej decyzji degradacja na E-cores
        json.dump({"pid": proc.pid, "pgid": proc.pid, "name": opt["name"],
                   "cmd": cmd, "started": t0, "hours": opt["hours"],
                   "normal": bool(opt["normal"])}, f, indent=1)

    def forward(signum, frame):
        try:
            os.killpg(proc.pid, signum)
        except Exception:
            pass

    signal.signal(signal.SIGINT, forward)
    signal.signal(signal.SIGTERM, forward)

    deadline = t0 + opt["hours"] * 3600
    rc, killed_by_time = limited_wait(proc, opt["cpu_limit"], deadline)
    if killed_by_time:
        print(T("safe-run: TIME BUDGET %.1f h reached - terminating the job (SIGTERM)") % opt["hours"])
        try:
            os.killpg(proc.pid, signal.SIGCONT)
            os.killpg(proc.pid, signal.SIGTERM)
        except Exception:
            pass
        for _ in range(30):
            if proc.poll() is not None:
                break
            time.sleep(1)
        if proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except Exception:
                pass
        rc = proc.wait()

    try:
        os.unlink(reg)
    except Exception:
        pass

    dur = time.time() - t0
    mx = max_temp_since(t0)
    print(T("safe-run: %s - exit code %s, took %dh %dm, peak temperature %s%s") % (
        opt["name"], rc, int(dur // 3600), int(dur % 3600 // 60),
        ("%.1f C" % mx) if mx else T("n/a"),
        (", " + T("terminated by the time budget")) if killed_by_time else ""))
    if rc is not None and rc < 0 and -rc in (signal.SIGTERM, signal.SIGKILL):
        print(T("safe-run: the job was stopped by signal %d - check ~/.coffee-paladin/guard.log") % -rc)
    # Zadanie ubite sygnalem daje rc ujemne (-15 SIGTERM, -9 SIGKILL). Zwracanie 0
    # znaczylo, ze `safe-run ... && nastepny_krok` szedl dalej po zadaniu przerwanym
    # w polowie - np. kolejka kompresji kasowala zrodlo po nieukonczonym enkodowaniu.
    # 128+sygnal to konwencja powloki dla "zabity sygnalem".
    if rc and rc < 0:
        return 128 - rc
    return rc if rc and rc > 0 else 0


if __name__ == "__main__":
    sys.exit(main())
